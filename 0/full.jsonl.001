n      \"review_comment\": {\n        \"href\": \"https://api.github.com/repos/entireio/entire-graph/pulls/comments{/number}\"\n      },\n      \"self\": {\n        \"href\": \"https://api.github.com/repos/entireio/entire-graph/pulls/78\"\n      }\n    },\n    \"author_association\": \"MEMBER\",\n    \"auto_merge\": null,\n    \"draft\": false,\n    \"merged\": true,\n    \"mergeable\": null,\n    \"rebaseable\": null,\n    \"mergeable_state\": \"unknown\",\n    \"merged_by\": {\n      \"login\": \"ashtom\",\n      \"id\": 70720,\n      \"node_id\": \"MDQ6VXNlcjcwNzIw\",\n      \"avatar_url\": \"https://avatars.githubusercontent.com/u/70720?v=4\",\n      \"gravatar_id\": \"\",\n      \"url\": \"https://api.github.com/users/ashtom\",\n      \"html_url\": \"https://github.com/ashtom\",\n      \"followers_url\": \"https://api.github.com/users/ashtom/followers\",\n      \"following_url\": \"https://api.github.com/users/ashtom/following{/other_user}\",\n      \"gists_url\": \"https://api.github.com/users/ashtom/gists{/gist_id}\",\n      \"starred_url\": \"https://api.github.com/users/ashtom/starred{/owner}{/repo}\",\n      \"subscriptions_url\": \"https://api.github.com/users/ashtom/subscriptions\",\n      \"organizations_url\": \"https://api.github.com/users/ashtom/orgs\",\n      \"repos_url\": \"https://api.github.com/users/ashtom/repos\",\n      \"events_url\": \"https://api.github.com/users/ashtom/events{/privacy}\",\n      \"received_events_url\": \"https://api.github.com/users/ashtom/received_events\",\n      \"type\": \"User\",\n      \"user_view_type\": \"public\",\n      \"site_admin\": false\n    },\n    \"comments\": 0,\n    \"review_comments\": 4,\n    \"maintainer_can_modify\": false,\n    \"commits\": 9,\n    \"additions\": 1313,\n    \"deletions\": 92,\n    \"changed_files\": 14\n  },\n  \"c\": {\n    \"comments\": [\n      {\n        \"url\": \"https://github.com/entireio/entire-graph/pull/78#discussion_r3699968046\",\n        \"body\": \"`isTerminal` treats any character device as a terminal. On Unix, that includes `/dev/null`, so `--format auto` could incorrectly choose the human text output even when stdout/stderr are redirected to `/dev/null` (not interactive). Consider at least excluding `os.DevNull` to keep the “terminal vs piped” behavior accurate without adding dependencies.\\n\\nThis issue also appears on line 57 of the same file.\",\n        \"user\": {\n          \"login\": \"Copilot\",\n          \"name\": \"Copilot\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 3699968046,\n        \"pull_request_review_id\": 4839415591,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-08-02T18:18:29Z\",\n        \"updated_at\": \"2026-08-02T18:18:30Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": 35,\n        \"start_line\": 12,\n        \"path\": \"internal/cli/progressbar.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\"><code class=\\\"notranslate\\\">isTerminal</code> treats any character device as a terminal. On Unix, that includes <code class=\\\"notranslate\\\">/dev/null</code>, so <code class=\\\"notranslate\\\">--format auto</code> could incorrectly choose the human text output even when stdout/stderr are redirected to <code class=\\\"notranslate\\\">/dev/null</code> (not interactive). Consider at least excluding <code class=\\\"notranslate\\\">os.DevNull</code> to keep the “terminal vs piped” behavior accurate without adding dependencies.</p>\\n<p dir=\\\"auto\\\">This issue also appears on line 57 of the same file.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-graph/pull/78#discussion_r3699968055\",\n        \"body\": \"This comment says \\\"`help`/`--help` still fall through to the root help\\\", but `help --help` is now intercepted by the per-command help block and prints the detail view instead. Updating the comment avoids confusing future readers about the control flow.\",\n        \"user\": {\n          \"login\": \"Copilot\",\n          \"name\": \"Copilot\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 3699968055,\n        \"pull_request_review_id\": 4839415591,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-08-02T18:18:29Z\",\n        \"updated_at\": \"2026-08-02T18:18:30Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": 56,\n        \"start_line\": 51,\n        \"path\": \"internal/cli/root.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\">This comment says \\\"<code class=\\\"notranslate\\\">help</code>/<code class=\\\"notranslate\\\">--help</code> still fall through to the root help\\\", but <code class=\\\"notranslate\\\">help --help</code> is now intercepted by the per-command help block and prints the detail view instead. Updating the comment avoids confusing future readers about the control flow.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-graph/pull/78#discussion_r3699968064\",\n        \"body\": \"`index` help text says `--format` supports `auto` (default), but the usage line omits it. Keeping these consistent helps users discover the default behavior.\\n\\nThis issue also appears on line 95 of the same file.\",\n        \"user\": {\n          \"login\": \"Copilot\",\n          \"name\": \"Copilot\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 3699968064,\n        \"pull_request_review_id\": 4839415591,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-08-02T18:18:30Z\",\n        \"updated_at\": \"2026-08-02T18:18:30Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": 92,\n        \"start_line\": 88,\n        \"path\": \"internal/cli/help.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\"><code class=\\\"notranslate\\\">index</code> help text says <code class=\\\"notranslate\\\">--format</code> supports <code class=\\\"notranslate\\\">auto</code> (default), but the usage line omits it. Keeping these consistent helps users discover the default behavior.</p>\\n<p dir=\\\"auto\\\">This issue also appears on line 95 of the same file.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-graph/pull/78#discussion_r3699968072\",\n        \"body\": \"`index` now defaults to `--format auto` (text when stdout is a terminal). Previously it always emitted JSON unless an invalid format was supplied, so this is a behavior change for any caller that parses `index` output from an interactive terminal. If backward compatibility for machine consumers is a goal, consider keeping the default as JSON and requiring `--format auto`/`--format text` explicitly.\",\n        \"user\": {\n          \"login\": \"Copilot\",\n          \"name\": \"Copilot\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 3699968072,\n        \"pull_request_review_id\": 4839415591,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-08-02T18:18:30Z\",\n        \"updated_at\": \"2026-08-02T18:18:30Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": 70,\n        \"start_line\": 57,\n        \"path\": \"internal/cli/index.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\"><code class=\\\"notranslate\\\">index</code> now defaults to <code class=\\\"notranslate\\\">--format auto</code> (text when stdout is a terminal). Previously it always emitted JSON unless an invalid format was supplied, so this is a behavior change for any caller that parses <code class=\\\"notranslate\\\">index</code> output from an interactive terminal. If backward compatibility for machine consumers is a goal, consider keeping the default as JSON and requiring <code class=\\\"notranslate\\\">--format auto</code>/<code class=\\\"notranslate\\\">--format text</code> explicitly.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-graph/pull/78#pullrequestreview-4839415591\",\n        \"body\": \"## Pull request overview\\n\\nThis PR overhauls the `entire graph` CLI help system, improves `index` UX (progress + human summary + `--force`), and fixes completeness reporting by introducing a repo-root `.graphignore` and adjusting which partial failures count toward “degraded”.\\n\\n**Changes:**\\n- Replace the monolithic help blob with a centralized help registry that powers grouped root help plus per-command `--help`.\\n- Improve `index` usability with a terminal-only progress bar, optional human-readable summary, and `--force` cache refresh behavior.\\n- Reduce false “completeness: degraded” reports via `.graphignore` and excluding intentional-skip failure codes from completeness level calculation.\\n\\n### Reviewed changes\\n\\nCopilot reviewed 14 out of 14 changed files in this pull request and generated 4 comments.\\n\\n<details>\\n<summary>Show a summary per file</summary>\\n\\n| File | Description |\\r\\n| ---- | ----------- |\\r\\n| internal/sem/search_cache.go | Adds `ForceRebuild` handling to preindex snapshot creation/persistence. |\\r\\n| internal/sem/search_cache_test.go | Adds regression test pinning `--force` preindex cache overwrite behavior. |\\r\\n| internal/sem/provider.go | Improves progress cadence and adjusts completeness computation to ignore intentional skips. |\\r\\n| internal/sem/ignore.go | Loads repo-root `.graphignore` for both worktree and explicit ignore matchers. |\\r\\n| internal/sem/completeness_test.go | Tests `.graphignore` matcher behavior and skip-code exclusion from completeness. |\\r\\n| internal/cli/stats_test.go | Updates help assertions to reflect new per-command `--help` behavior. |\\r\\n| internal/cli/root.go | Centralizes per-command help interception and improves unknown-command messaging. |\\r\\n| internal/cli/root_test.go | Adjusts help-related test to assert per-command help output. |\\r\\n| internal/cli/progressbar.go | Adds dependency-free terminal progress bar rendering utilities. |\\r\\n| internal/cli/progressbar_test.go | Adds tests for TTY detection and progress bar rendering/clearing. |\\r\\n| internal/cli/index.go | Implements `--force`, progress bar wiring, and `--format`-based text/JSON output selection. |\\r\\n| internal/cli/help.go | Introduces command help registry + renderers for grouped root help and per-command help. |\\r\\n| internal/cli/help_test.go | Adds parity tests between dispatch switch and help registry; tests `--help` interception. |\\r\\n| .graphignore | Adds repo-root ignore patterns to exclude generated tree-sitter `parser.c`/`scanner.c` files. |\\n</details>\\n\\n\\n\\n\\n\\n<details>\\n<summary>Suppressed comments (2)</summary>\\n\\n**internal/cli/progressbar.go:60**\\n* The progress bar treats the \\\"summary\\\" phase as \\\"relations\\\" and prints \\\"linking relations\\\" even though work is complete. Letting \\\"summary\\\" fall through to the default branch will render the final 100% file bar instead, which reads as completion.\\n```\\n\\tswitch e.Phase {\\n\\tcase \\\"relations\\\", \\\"summary\\\":\\n\\t\\tline = fmt.Sprintf(\\\"%s %c linking relations · %s relations · %s symbols · %s\\\",\\n\\t\\t\\tb.label, spin, humanInt(int64(e.Relations)), humanInt(int64(e.Symbols)), elapsed)\\n```\\n**internal/cli/help.go:99**\\n'"],"cwd":"file:///Users/puneetpalsingh/Documents/Code/OSSplayground/Entire/cli","parsed_cmd":[{"type":"unknown","cmd":"python3 -c 'import sys;open(sys.argv[1],\"ab\").write(sys.argv[2].encode())' '/Users/puneetpalsingh/.codex/entire-20-audit-2026-11-16/public/entire-graph-78.json' 'on\": \"🪾 Make your agents more efficient with a precomputed map of your Git repository: ranked code search plus definitions, callers, types, routes, and change impact, each with file:line locations.\",\n        \"homepage\": \"\",\n        \"language\": \"C\",\n        \"visibility\": \"public\",\n        \"is_template\": false,\n        \"topics\": [],\n        \"forks_count\": 82,\n        \"forks\": 82,\n        \"stargazers_count\": 138,\n        \"watchers_count\": 138,\n        \"watchers\": 138,\n        \"open_issues_count\": 37,\n        \"open_issues\": 37,\n        \"size\": 546697,\n        \"default_branch\": \"main\",\n        \"has_issues\": true,\n        \"has_projects\": false,\n        \"has_wiki\": true,\n        \"has_pages\": false,\n        \"has_downloads\": false,\n        \"has_discussions\": false,\n        \"has_pull_requests\": true,\n        \"pushed_at\": \"2026-11-14T06:09:28Z\",\n        \"created_at\": \"2026-05-28T12:38:52Z\",\n        \"updated_at\": \"2026-11-16T03:42:45Z\",\n        \"allow_forking\": true,\n        \"web_commit_signoff_required\": false,\n        \"pull_request_creation_policy\": \"all\",\n        \"license\": {\n          \"key\": \"mit\",\n          \"name\": \"MIT License\",\n          \"url\": \"https://api.github.com/licenses/mit\",\n          \"spdx_id\": \"MIT\",\n          \"node_id\": \"MDc6TGljZW5zZTEz\"\n        },\n        \"url\": \"https://api.github.com/repos/entireio/entire-graph\",\n        \"html_url\": \"https://github.com/entireio/entire-graph\",\n        \"archive_url\": \"https://api.github.com/repos/entireio/entire-graph/{archive_format}{/ref}\",\n        \"assignees_url\": \"https://api.github.com/repos/entireio/entire-graph/assignees{/user}\",\n        \"blobs_url\": \"https://api.github.com/repos/entireio/entire-graph/git/blobs{/sha}\",\n        \"branches_url\": \"https://api.github.com/repos/entireio/entire-graph/branches{/branch}\",\n        \"collaborators_url\": \"https://api.github.com/repos/entireio/entire-graph