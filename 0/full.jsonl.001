rs.githubusercontent.com/in/1210556?v=4\",\n          \"id\": 206951365\n        },\n        \"id\": 3813268177,\n        \"pull_request_review_id\": 4972490799,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-08-19T13:13:18Z\",\n        \"updated_at\": \"2026-08-19T13:13:18Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": 52,\n        \"start_line\": null,\n        \"path\": \"internal/gitproto/samesite.go\",\n        \"body_html\": \"<h3 dir=\\\"auto\\\">Default ports treated as different sites</h3>\\n<p dir=\\\"auto\\\"><strong>Medium Severity</strong></p>\\n\\n<p dir=\\\"auto\\\"><code class=\\\"notranslate\\\">sameSite</code> compares <code class=\\\"notranslate\\\">Port()</code> literally, so an implicit default (<code class=\\\"notranslate\\\">https://host</code>) and the same origin with an explicit default (<code class=\\\"notranslate\\\">https://host:443</code>, or <code class=\\\"notranslate\\\">http://host:80</code>) are treated as different sites. A normal redirect that adds or drops the default port withholds credentials and can 401 a same-origin replica.</p>\\n\\n\\n\\n<div dir=\\\"auto\\\"><a href=\\\"https://cursor.com/open?REDACTED\\\" rel=\\\"nofollow\\\"><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/a3745bd9c9e494e3d083228c1efdaf4ec2d519ad1c6adb4160d1c56c1ddeeb7b/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://camo.githubusercontent.com/8f892a2b1c7e36d49621daf12d83d3200c0ad6842ca1f6d8422631d06c99b3b2/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6c696768742e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-light.png\\\"><img alt=\\\"Fix in Cursor\\\" width=\\\"115\\\" height=\\\"28\\\" src=\\\"https://camo.githubusercontent.com/a3745bd9c9e494e3d083228c1efdaf4ec2d519ad1c6adb4160d1c56c1ddeeb7b/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"></picture></themed-picture></a> <a href=\\\"https://cursor.com/agents?REDACTED\\\" rel=\\\"nofollow\\\"><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/d32f310773b0b80ca3035d8154dc711fc85b63281369057b12943376f7715734/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d7765622d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://camo.githubusercontent.com/17d98663d2364520c70e7bc21f8c60be71acb1cdae85dd48a2ff2278158e3dbb/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d7765622d6c696768742e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-web-light.png\\\"><img alt=\\\"Fix in Web\\\" width=\\\"99\\\" height=\\\"28\\\" src=\\\"https://camo.githubusercontent.com/d32f310773b0b80ca3035d8154dc711fc85b63281369057b12943376f7715734/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d7765622d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"></picture></themed-picture></a></div>\\n<p dir=\\\"auto\\\"><sup>Reviewed by <a href=\\\"https://cursor.com/bugbot\\\" rel=\\\"nofollow\\\">Cursor Bugbot</a> for commit <a class=\\\"commit-link\\\" data-hovercard-type=\\\"commit\\\" data-hovercard-url=\\\"https://github.com/entireio/git-sync/commit/b0e0f88541d3bbbe472233a7ce0bbe63124c4115/hovercard\\\" href=\\\"https://github.com/entireio/git-sync/commit/b0e0f88541d3bbbe472233a7ce0bbe63124c4115\\\"><tt>b0e0f88</tt></a>. Configure <a href=\\\"https://www.cursor.com/dashboard/bugbot\\\" rel=\\\"nofollow\\\">here</a>.</sup></p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/git-sync/pull/108#discussion_r3813268184\",\n        \"body\": \"### Helper fallback warning is incorrect\\n\\n**Medium Severity**\\n\\n<!-- DESCRIPTION START -->\\nWhen an explicit token is withheld, the warning always says the git credential helper will be consulted, and `tryHelperRetry` only runs if `CredentialHelper` is set. Production `newConn` installs a helper only when `Auth` is nil, so a `--source-token` / `--target-token` user who hits a cross-site redirect gets a 401 and no helper lookup, despite docs telling them to store creds for that host.\\n<!-- DESCRIPTION END -->\\n\\n<!-- BUGBOT_BUG_ID: 0060ddb0-f471-4754-a964-5e9d48f931cf -->\\n\\n<!-- LOCATIONS START\\ninternal/gitproto/smarthttp.go#L394-L408\\ninternal/gitproto/smarthttp.go#L796-L801\\nLOCATIONS END -->\\n<details>\\n<summary>Additional Locations (1)</summary>\\n\\n- [`internal/gitproto/smarthttp.go#L796-L801`](https://github.com/entireio/git-sync/blob/b0e0f88541d3bbbe472233a7ce0bbe63124c4115/internal/gitproto/smarthttp.go#L796-L801)\\n\\n</details>\\n\\n<div><a href=\\\"https://cursor.com/open?REDACTED\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-cursor-light.png\\\"><img alt=\\\"Fix in Cursor\\\" width=\\\"115\\\" height=\\\"28\\\" src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"></picture></a>&nbsp;<a href=\\\"https://cursor.com/agents?REDACTED\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-web-light.png\\\"><img alt=\\\"Fix in Web\\\" width=\\\"99\\\" height=\\\"28\\\" src=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"></picture></a></div>\\n\\n\\n<sup>Reviewed by [Cursor Bugbot](https://cursor.com/bugbot) for commit b0e0f88541d3bbbe472233a7ce0bbe63124c4115. Configure [here](https://www.cursor.com/dashboard/bugbot).</sup>\\n\",\n        \"user\": {\n          \"login\": \"cursor[bot]\",\n          \"name\": \"cursor[bot]\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/1210556?v=4\",\n          \"id\": 206951365\n        },\n        \"id\": 3813268184,\n        \"pull_request_review_id\": 4972490799,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-08-19T13:13:18Z\",\n        \"updated_at\": \"2026-08-19T13:13:18Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": \"internal/gitproto/smarthttp.go\",\n        \"body_html\": \"<h3 dir=\\\"auto\\\">Helper fallback warning is incorrect</h3>\\n<p dir=\\\"auto\\\"><strong>Medium Severity</strong></p>\\n\\n<p dir=\\\"auto\\\">When an explicit token is withheld, the warning always says the git credential helper will be consulted, and <code class=\\\"notranslate\\\">tryHelperRetry</code> only runs if <code class=\\\"notranslate\\\">CredentialHelper</code> is set. Production <code class=\\\"notranslate\\\">newConn</code> installs a helper only when <code class=\\\"notranslate\\\">Auth</code> is nil, so a <code class=\\\"notranslate\\\">--source-token</code> / <code class=\\\"notranslate\\\">--target-token</code> user who hits a cross-site redirect gets a 401 and no helper lookup, despite docs telling them to store creds for that host.</p>\\n\\n\\n\\n<details>\\n<summary>Additional Locations (1)</summary>\\n<ul dir=\\\"auto\\\">\\n<li><a href=\\\"https://github.com/entireio/git-sync/blob/b0e0f88541d3bbbe472233a7ce0bbe63124c4115/internal/gitproto/smarthttp.go#L796-L801\\\"><code class=\\\"notranslate\\\">internal/gitproto/smarthttp.go#L796-L801</code></a></li>\\n</ul>\\n</details>\\n<div dir=\\\"auto\\\"><a href=\\\"https://cursor.com/open?REDACTED\\\" rel=\\\"nofollow\\\"><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/a3745bd9c9e494e3d083228c1efdaf4ec2d519ad1c6adb4160d1c56c1ddeeb7b/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://camo.githubusercontent.com/8f892a2b1c7e36d49621daf12d83d3200c0ad6842ca1f6d8422631d06c99b3b2/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6c696768742e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-light.png\\\"><img alt=\\\"Fix in Cursor\\\" width=\\\"115\\\" height=\\\"28\\\" src=\\\"https://camo.githubusercontent.com/a3745bd9c9e494e3d083228c1efdaf4ec2d519ad1c6adb4160d1c56c1ddeeb7b/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"></picture></themed-picture></a> <a href=\\\"https://cursor.com/agents?REDACTED\\\" rel=\\\"nofollow\\\"><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/d32f310773b0b80ca3035d8154dc711fc85b63281369057b12943376f7715734/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d7765622d6461726b2e706e67\\\" data-