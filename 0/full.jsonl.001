.com/users/entireio/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/entireio/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/entireio/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/entireio/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/entireio/orgs\",\n        \"repos_url\": \"https://api.github.com/users/entireio/repos\",\n        \"events_url\": \"https://api.github.com/users/entireio/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/entireio/received_events\",\n        \"type\": \"Organization\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      }\n    },\n    \"_links\": {\n      \"comments\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/issues/3002/comments\"\n      },\n      \"commits\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/3002/commits\"\n      },\n      \"statuses\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/statuses/a92b57d47a6a9e1deaa7d437becb70041558a7ab\"\n      },\n      \"html\": {\n        \"href\": \"https://github.com/entireio/cli/pull/3002\"\n      },\n      \"issue\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/issues/3002\"\n      },\n      \"review_comments\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/3002/comments\"\n      },\n      \"review_comment\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/comments{/number}\"\n      },\n      \"self\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/3002\"\n      }\n    },\n    \"author_association\": \"NONE\",\n    \"auto_merge\": null,\n    \"draft\": false,\n    \"merged\": true,\n    \"mergeable\": null,\n    \"rebaseable\": null,\n    \"mergeable_state\": \"unknown\",\n    \"merged_by\": {\n      \"login\": \"Soph\",\n      \"id\": 70741,\n      \"node_id\": \"MDQ6VXNlcjcwNzQx\",\n      \"avatar_url\": \"https://avatars.githubusercontent.com/u/70741?v=4\",\n      \"gravatar_id\": \"\",\n      \"url\": \"https://api.github.com/users/Soph\",\n      \"html_url\": \"https://github.com/Soph\",\n      \"followers_url\": \"https://api.github.com/users/Soph/followers\",\n      \"following_url\": \"https://api.github.com/users/Soph/following{/other_user}\",\n      \"gists_url\": \"https://api.github.com/users/Soph/gists{/gist_id}\",\n      \"starred_url\": \"https://api.github.com/users/Soph/starred{/owner}{/repo}\",\n      \"subscriptions_url\": \"https://api.github.com/users/Soph/subscriptions\",\n      \"organizations_url\": \"https://api.github.com/users/Soph/orgs\",\n      \"repos_url\": \"https://api.github.com/users/Soph/repos\",\n      \"events_url\": \"https://api.github.com/users/Soph/events{/privacy}\",\n      \"received_events_url\": \"https://api.github.com/users/Soph/received_events\",\n      \"type\": \"User\",\n      \"user_view_type\": \"public\",\n      \"site_admin\": false\n    },\n    \"comments\": 0,\n    \"review_comments\": 2,\n    \"maintainer_can_modify\": false,\n    \"commits\": 12,\n    \"additions\": 725,\n    \"deletions\": 1,\n    \"changed_files\": 7\n  },\n  \"c\": {\n    \"comments\": [\n      {\n        \"url\": \"https://github.com/entireio/cli/pull/3002#discussion_r4466448653\",\n        \"body\": \"The detached cleanup DELETE and completion-recovery GET can wait indefinitely if the cell stops responding: `context.WithoutCancel` removes deadlines and cancellation, and the API client has no HTTP timeout. Bound both requests with `context.WithTimeout` so failed or canceled uploads can return an error while preserving the attachment when its state cannot be read. The same issue occurs in the readiness lookup at line 191.\",\n        \"user\": {\n          \"login\": \"Copilot\",\n          \"name\": \"Copilot\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 4466448653,\n        \"pull_request_review_id\": 5766979829,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-11-04T10:36:03Z\",\n        \"updated_at\": \"2026-11-04T10:36:04Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": \"cmd/entire/cli/project_trail_attachment_cmd.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\">The detached cleanup DELETE and completion-recovery GET can wait indefinitely if the cell stops responding: <code class=\\\"notranslate\\\">context.WithoutCancel</code> removes deadlines and cancellation, and the API client has no HTTP timeout. Bound both requests with <code class=\\\"notranslate\\\">context.WithTimeout</code> so failed or canceled uploads can return an error while preserving the attachment when its state cannot be read. The same issue occurs in the readiness lookup at line 191.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/cli/pull/3002#discussion_r4466448751\",\n        \"body\": \"This assertion fails on Windows: a missing file produces an OS error such as “The system cannot find the file specified,” not “no such file.” Check this case with `require.ErrorIs(t, err, os.ErrNotExist)` instead of matching platform-specific text; the command already wraps the underlying error with `%w`.\",\n        \"user\": {\n          \"login\": \"Copilot\",\n          \"name\": \"Copilot\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 4466448751,\n        \"pull_request_review_id\": 5766979829,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-11-04T10:36:03Z\",\n        \"updated_at\": \"2026-11-04T10:36:04Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": \"cmd/entire/cli/project_trail_attachment_cmd_test.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\">This assertion fails on Windows: a missing file produces an OS error such as “The system cannot find the file specified,” not “no such file.” Check this case with <code class=\\\"notranslate\\\">require.ErrorIs(t, err, os.ErrNotExist)</code> instead of matching platform-specific text; the command already wraps the underlying error with <code class=\\\"notranslate\\\">%w</code>.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/cli/pull/3002#pullrequestreview-5766979829\",\n        \"body\": \"<!-- ccr-overview-v2 -->\\n\\n### 🟡 Changes recommended\\n\\nDetached cleanup and state-lookup requests can hang indefinitely without timeouts, and a missing-file test assertion fails on Windows because it matches platform-specific error text.\\n\\n<details open>\\n<summary><strong>2 open issues</strong></summary>\\n\\n- <picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\\\"><img src=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\\\" alt=\\\"Medium severity\\\" width=\\\"62\\\" height=\\\"18\\\" align=\\\"texttop\\\"></picture> [Bound detached API requests with timeouts](https://github.com/entireio/cli/pull/3002#discussion_r4466448653) · New\\n- <picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\\\"><img src=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.png\\\" alt=\\\"Medium severity\\\" width=\\\"62\\\" height=\\\"18\\\" align=\\\"texttop\\\"></picture> [Use os.ErrNotExist for portable missing-file assertion](https://github.com/entireio/cli/pull/3002#discussion_r4466448751) · New\\n</details>\\n\\n<details>\\n<summary><strong>What changed in this PR</strong></summary>\\n\\nAdds image attachment management to project trails, letting users upload images and reference them in trail descriptions without automatically editing the body.\\n\\n**Changes:**\\n- Adds `trail attachment add`, `list`, and force-confirmed `remove`, using existing trail selectors.\\n- Implements image validation, token-free presigned uploads, completion recovery, and cleanup of failed uploads.\\n- Adds API types, command tests, usage documentation, and agent guidance for preserving image references.\\n\\n| File | Description |\\r\\n| ---- | ----------- |\\r\\n| `README.md` | Adds an image-upload usage example. |\\r\\n| `docs/​architecture/​project-trails-cli.md` | Documents attachment commands and upload behavior. |\\r\\n| `cmd/​entire/​cli/​trail_cmd.go` | Registers attachment commands for project trails. |\\r\\n| `cmd/​entire/​cli/​project_trail_attachment_cmd.go` | Implements attachment validation, upload, listing, and deletion. |\\r\\n| `cmd/​entire/​cli/​project_trail_attachment_cmd_test.go` | Tests commands, validation, upload failures, and completion recovery. |\\r\\n| `cmd/​entire/​cli/​api/​project_trail_attachments.go` | Defines attachment request and response types. |\\r\\n| `cmd/​entire/​cli/​agent_help_cmd.go` | Classifies commands and adds image-preservation and deletion guidance. |\\n</details>\\n\\n<sub>Review effort: Balanced</sub>\",\n        \"user\": {\n          \"login\": \"copilot-pull-request-reviewer[bot]\",\n          \"name\": \"copilot-pull-request-reviewer[bot]\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/946600?v=4\",\n          \"id\": 175728472\n        },\n        \"id\": 5766979829,\n        \"pull_request_review_id\": null,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-11-04T10:36:04Z\",\n        \"updated_at\": null,\n        \"review\": \"COMMENTED\",\n        \"side\": null,\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": null,\n        \"body_html\": \"\\n<h3 dir=\\\"auto\\\">🟡 Changes recommended</h3>\\n<p dir=\\\"auto\\\">Detached cleanup and state-lookup requests can hang indefinitely without timeouts, and a missing-file test assertion fails on Windows because it matches platform-specific error text.</p>\\n<details open=\\\"\\\">\\n<summary><strong>2 open issues</strong></summary>\\n<ul dir=\\\"auto\\\">\\n<li><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/3868f518af8a13817c492e417e4bcdd49346975a4f3786c3e8dda094400fe94a/68747470733a2f2f6769746875622e6769746875626173736574732e636f6d2f7374617469632f696d616765732f69636f6e732f636f70696c6f742d636f64652d7265766965772f6d656469756d2d76322d6461726b2e737667\\\" data-canonical-src=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-dark.svg\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://camo.githubusercontent.com/4e401c45fe265191ce60dd43159ae6873ccb06626b2c0546f0b466d3511d457d/68747470733a2f2f6769746875622e6769746875626173736574732e636f6d2f7374617469632f696d616765732f69636f6e732f636f70696c6f742d636f64652d7265766965772f6d656469756d2d76322d6c696768742e737667\\\" data-canonical-src=\\\"https://github.githubassets.com/static/images/icons/copilot-code-review/medium-v2-light.svg\\\"><img src=\\\"https://camo.githubusercontent.com/7dc8929f1372d7be218d83fe61e6c3fb67ed8bc61cd50c1e8e4696827da90595/68747470733a2f2f6769746875622e6769746875626173736574732e636f6d2f73