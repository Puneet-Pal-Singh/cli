sers/Soph/subscriptions\",\n                \"organizations_url\": \"https://api.github.com/users/Soph/orgs\",\n                \"repos_url\": \"https://api.github.com/users/Soph/repos\",\n                \"events_url\": \"https://api.github.com/users/Soph/events{/privacy}\",\n                \"received_events_url\": \"https://api.github.com/users/Soph/received_events\",\n                \"type\": \"User\",\n                \"user_view_type\": \"public\",\n                \"site_admin\": false\n              },\n              \"labels\": [],\n              \"state\": \"closed\",\n              \"locked\": false,\n              \"assignees\": [],\n              \"milestone\": null,\n              \"comments\": 0,\n              \"created_at\": \"2026-11-06T14:46:38Z\",\n              \"updated_at\": \"2026-11-06T15:13:14Z\",\n              \"closed_at\": \"2026-11-06T15:13:11Z\",\n              \"assignee\": null,\n              \"author_association\": \"COLLABORATOR\",\n              \"issue_field_values\": [],\n              \"type\": null,\n              \"active_lock_reason\": null,\n              \"draft\": false,\n              \"pull_request\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/pulls/3038\",\n                \"html_url\": \"https://github.com/entireio/cli/pull/3038\",\n                \"diff_url\": \"https://github.com/entireio/cli/pull/3038.diff\",\n                \"patch_url\": \"https://github.com/entireio/cli/pull/3038.patch\",\n                \"merged_at\": \"2026-11-06T15:13:10Z\"\n              },\n              \"body\": \"This draft pull request was opened by [Entire](https://entire.com) to back a trail. Feel free to edit the title or body, but keep the hidden marker below: Entire uses it to close this pull request when the trail closes.\\n\\n<!-- entire-shadow-pr -->\\n\\n<!-- CURSOR_SUMMARY -->\\n---\\n\\n> [!NOTE]\\n> **Low Risk**\\n> Documentation-only release notes; no runtime or security behavior change from merging this diff.\\n> \\n> **Overview**\\n> **Documents the 0.13.0 (2026-11-06) release** in `CHANGELOG.md`: notable **additions** (checkpoint push policy automatic/manual, OpenCode 2 plugin path, trail commands—ready, retarget, rerun-review, timeline/sessions/stack, finding replies, attachments, `list --mine`, service accounts, repo default-branch, project `--cell`, plugin upgrade hints), **changes** (trail runners → project agents, finding UI cards, trail create base/trails checks, checkpoint trailer parsing, pre-push ref forwarding, config validation, root `$HOME`, Codex/Pi streaming, ref listing for push/status, Nix update-check skip), **fixes** (checkpoint remote URL, batched ref pushes on Windows, foreground fetch timeouts, legacy checkpoint merge, shallow recovery, degraded writes, subagents, hooks, session attach signing, Windows workers, maintenance packs, `git-remote-entire`, trail UX, findings scope, session warning, PATH installer), and **housekeeping** (CI cognitive complexity, README pointer, shared replay, tests, deps, thanks).\\n> \\n> This PR only updates the changelog; it does not ship the features themselves.\\n> \\n> <sup>Reviewed by [Cursor Bugbot](https://cursor.com/bugbot) for commit 8da0a85940a24f8a444b05c7805cd254839f4c03. Configure [here](https://www.cursor.com/dashboard/bugbot).</sup>\\n<!-- /CURSOR_SUMMARY -->\",\n              \"reactions\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/issues/3038/reactions\",\n                \"total_count\": 0,\n                \"+1\": 0,\n                \"-1\": 0,\n                \"laugh\": 0,\n                \"hooray\": 0,\n                \"confused\": 0,\n                \"heart\": 0,\n                \"rocket\": 0,\n                \"eyes\": 0\n              },\n              \"timeline_url\": \"https://api.github.com/repos/entireio/cli/issues/3038/timeline\",\n              \"performed_via_github_app\": {\n                \"id\": 2626939,\n                \"client_id\": \"Iv23lieFG10uOnChW4TN\",\n                \"slug\": \"entire\",\n                \"node_id\": \"A_kwHOAfprLM4AKBV7\",\n                \"owner\": {\n                  \"login\": \"entireio\",\n                  \"id\": 33188652,\n                  \"node_id\": \"MDEyOk9yZ2FuaXphdGlvbjMzMTg4NjUy\",\n                  \"avatar_url\": \"https://avatars.githubusercontent.com/u/33188652?v=4\",\n                  \"gravatar_id\": \"\",\n                  \"url\": \"https://api.github.com/users/entireio\",\n                  \"html_url\": \"https://github.com/entireio\",\n                  \"followers_url\": \"https://api.github.com/users/entireio/followers\",\n                  \"following_url\": \"https://api.github.com/users/entireio/following{/other_user}\",\n                  \"gists_url\": \"https://api.github.com/users/entireio/gists{/gist_id}\",\n                  \"starred_url\": \"https://api.github.com/users/entireio/starred{/owner}{/repo}\",\n                  \"subscriptions_url\": \"https://api.github.com/users/entireio/subscriptions\",\n                  \"organizations_url\": \"https://api.github.com/users/entireio/orgs\",\n                  \"repos_url\": \"https://api.github.com/users/entireio/repos\",\n                  \"events_url\": \"https://api.github.com/users/entireio/events{/privacy}\",\n                  \"received_events_url\": \"https://api.github.com/users/entireio/received_events\",\n                  \"type\": \"Organization\",\n                  \"user_view_type\": \"public\",\n                  \"site_admin\": false\n                },\n                \"name\": \"Entire\",\n                \"description\": \"\",\n                \"external_url\": \"https://entire.com\",\n                \"html_url\": \"https://github.com/apps/entire\",\n                \"created_at\": \"2026-01-09T21:20:56Z\",\n                \"updated_at\": \"2026-10-23T08:32:31Z\",\n                \"permissions\": {\n                  \"administration\": \"read\",\n                  \"checks\": \"write\",\n                  \"contents\": \"write\",\n                  \"emails\": \"read\",\n                  \"members\": \"read\",\n                  \"metadata\": \"read\",\n                  \"pull_requests\": \"write\",\n                  \"statuses\": \"read\",\n                  \"workflows\": \"write\"\n                },\n                \"events\": [\n                  \"check_suite\",\n                  \"create\",\n                  \"delete\",\n                  \"fork\",\n                  \"member\",\n                  \"membership\",\n                  \"organization\",\n                  \"pull_request\",\n                  \"push\",\n                  \"repository\",\n                  \"star\",\n                  \"team\"\n                ]\n              },\n              \"state_reason\": null,\n              \"score\": 1\n            },\n            {\n              \"url\": \"https://api.github.com/repos/entireio/cli/issues/2632\",\n              \"repository_url\": \"https://api.github.com/repos/entireio/cli\",\n              \"labels_url\": \"https://api.github.com/repos/entireio/cli/issues/2632/labels{/name}\",\n              \"comments_url\": \"https://api.github.com/repos/entireio/cli/issues/2632/comments\",\n              \"events_url\": \"https://api.github.com/repos/entireio/cli/issues/2632/events\",\n              \"html_url\": \"https://github.com/entireio/cli/pull/2632\",\n              \"id\": 5652638608,\n              \"node_id\": \"PR_kwDOQyo98M8AAAABF-KUdQ\",\n              \"number\": 2632,\n              \"title\": \"Add hidden `entire checkpoint create` for snapshot checkpoints\",\n              \"user\": {\n                \"login\": \"Soph\",\n                \"id\": 70741,\n                \"node_id\": \"MDQ6VXNlcjcwNzQx\",\n                \"avatar_url\": \"https://avatars.githubusercontent.com/u/70741?v=4\",\n                \"gravatar_id\": \"\",\n                \"url\": \"https://api.github.com/users/Soph\",\n                \"html_url\": \"https://github.com/Soph\",\n                \"followers_url\": \"https://api.github.com/users/Soph/followers\",\n                \"following_url\": \"https://api.github.com/users/Soph/following{/other_user}\",\n                \"gists_url\": \"https://api.github.com/users/Soph/gists{/gist_id}\",\n                \"starred_url\": \"https://api.github.com/users/Soph/starred{/owner}{/repo}\",\n                \"subscriptions_url\": \"https://api.github.com/users/Soph/subscriptions\",\n                \"organizations_url\": \"https://api.github.com/users/Soph/orgs\",\n                \"repos_url\": \"https://api.github.com/users/Soph/repos\",\n                \"events_url\": \"https://api.github.com/users/Soph/events{/privacy}\",\n                \"received_events_url\": \"https://api.github.com/users/Soph/received_events\",\n                \"type\": \"User\",\n                \"user_view_type\": \"public\",\n                \"site_admin\": false\n              },\n              \"labels\": [],\n              \"state\": \"closed\",\n              \"locked\": false,\n              \"assignees\": [],\n              \"milestone\": null,\n              \"comments\": 0,\n              \"created_at\": \"2026-09-30T20:31:31Z\",\n              \"updated_at\": \"2026-10-04T20:35:46Z\",\n              \"closed_at\": \"2026-10-04T20:35:44Z\",\n              \"assignee\": null,\n              \"author_association\": \"COLLABORATOR\",\n              \"issue_field_values\": [],\n              \"type\": null,\n              \"active_lock_reason\": null,\n              \"draft\": false,\n              \"pull_request\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/pulls/2632\",\n                \"html_url\": \"https://github.com/entireio/cli/pull/2632\",\n                \"diff_url\": \"https://github.com/entireio/cli/pull/2632.diff\",\n                \"patch_url\": \"https://github.com/entireio/cli/pull/2632.patch\",\n                \"merged_at\": \"2026-10-04T20:35:43Z\"\n              },\n              \"body\": \"<!-- entire-trail-link-start -->\\nhttps://entire.io/gh/entireio/cli/trails/1458\\n<!-- entire-trail-link-end -->\\n\\n## Why\\n\\nA session that changes no files (research, planning, review) never gets a checkpoint today. Turn end skips `SaveStep` when nothing changed (`lifecycle.go`, \\\"no files modified during session, skipping checkpoint\\\"), so the session has no steps, and at session end `PrepareSessionEndCondensation` marks it condensed without writing anything. The sweep and doctor only condense sessions with steps. The work in those sessions is lost, and there is no checkpoint ID to share.\\n\\n## What\\n\\nAdds a hidden `entire checkpoint create [session-id]` that writes a checkpoint from such a session's current transcript and prints its ID (`--json` returns `{checkpoint_id, session_id, resolution}`).\\n\\n- **Sessions with uncommitted file changes are refused** (\\\"its work is checkpointed when you commit\\\"). Their next commit checkpoints that work with attribution; a snapshot would only duplicate it. Pending changes come from `resolveFilesTouched`: most agents report no per-tool file events, so an edit earlier in the current turn is only in the live transcript until turn end. Paths outside the worktree, such as an agent's plan files, don't count.\\n- **No argument means the calling agent's own session**, accepted only when it is identified from the agent's session env var or process ancestry (`SessionResolution.IsCaller()`). Most-recent-session guesses are refused, and the refusal does not print the guessed ID, since an agent would feed it straight back as an explicit one. An agent that names a session Entire has no state for is reported, not substituted.\\n- **Stdout carries only the ID or JSON.** In a disabled repository the notice goes to stderr and the command fails, so `id=$(entire checkpoint create)` never captures prose.\\n\\n## How\\n\\nThe write goes through `CondenseSession`, so transcript extraction (including the turn in progress), sanitize → image externalization → redaction, summary generation when enabled, and the store write are unchanged. The store write already handles push: git-refs enqueues the ref in the push queue, and the branch backend's v1 commit is counted as unpushed.\\n\\n`CreateSnapshotCheckpoint` (`strategy/manual_commit_snapshot.go`):\\n\\n- **Runs under the session's state lock**, inside `MutateSessionState`, like every other condensation. The per-session redaction prefix cache writes its payload and entry in two steps; an unlocked writer racing a commit's condensation can leave the entry pointing at the other writer's payload, which splices duplicated or dropped lines into every later checkpoint of the session.\\n- **Never saves state back** (`ErrMutationSkip`), so the session's window is untouched and repeated snapshots each cover the session from the same start. They overlap one another, as carry-forward checkpoints already do; `entire tokens profile` already discloses overlapping checkpoint history.\\n- **Fails on redaction errors** (`condenseOpts.failOnRedactionError`) instead of the hook paths' drop-and-continue: a snapshot exists for its transcript, so a failure must not produce an ID for a transcript-less checkpoint or a misleading \\\"nothing to checkpoint\\\".\\n- **Records no commit attribution** (`condenseOpts.noCommitAttribution`): attribution diffs the shadow tree against HEAD assuming HEAD holds the committed work, which is false without a commit.\\n- **Emits no skill telemetry**, since unsaved state never marks the events persisted.\\n\\nDocs: the snapshot contract in `checkpoint-implementation.md`, commitless checkpoints in `sessions-and-checkpoints.md`, `IsCaller()` now guarding this command in `caller-session-resolution.md`, and the \\\"written at commit time\\\" line in `security-and-privacy.md`.\\n\\n## For review: product calls\\n\\n- **Hidden, classified user-owned / unlisted** in `agentHelpClassification`, the safe default from the CLI conventions. If agents should call it unprompted, it needs to become task-driven, and the line Entire injects into agent sessions (\\\"never create checkpoints by hand\\\") would need rewording.\\n- **Sessions with no file changes still lose everything after their last snapshot when they end**, because session end writes nothing for them. Always preserving such sessions would mean session end writing a checkpoint for any non-empty transcript: a separate decision with storage cost.\\n\\n## Not in this PR\\n\\n- Branch label for a session from another worktree: the checkpoint records the branch and uses the settings of the worktree the command runs in. Post-commit already behaves the same way for sessions linked from other worktrees.\\n- A failed subagent transcript redaction is still stored without the transcript (`TranscriptUnavailableReason = redaction_failed`) rather than failing the snapshot.\\n- Edits made through a shell command (`sed`, a script, a generator) rather than an edit tool are invisible to both the transcript and the per-tool file hooks until turn end, so a snapshot in that same turn is not refused. The snapshot then overlaps the next commit's checkpoint; attribution is skipped either way. Closing this needs a working-tree diff against the turn-start state, and refusing any dirty worktree instead would block research in repos with unrelated uncommitted changes.\\n\\n## Testing\\n\\n- Strategy (`manual_commit_snapshot_test.go`), for a session with no file changes: the checkpoint contains the in-progress turn with its secret redacted, and reloaded state equals the state before; pending file changes are refused and nothing is written, including an edit that is only in the current turn's transcript, while a plan file written outside the worktree is allowed; redaction runs under the session lock, proven by a second writer timing out on the lock from inside redaction; a forced redaction failure is an error and writes nothing; unknown session and nothing-to-checkpoint errors. `noCommitAttribution` is tested directly on `CondenseSession`, with a control write that does record attribution.\\n- CLI (`checkpoint_create_test.go`): the caller's own session is checkpointed and `--json` reports `caller-env`; a `worktree` guess is refused without naming the guessed session; an untracked caller is named, not replaced by a decoy; pending file changes are refused with nothing on stdout; a disabled repo fails with empty stdout; invalid, unknown and empty session IDs.\\n- Each guard was checked by removing it: the lock, the pending-files check, attribution, fail-closed redaction, the disabled-guard change, and the hidden guess each make their test fail.\\n\\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\\n\",\n              \"reactions\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/issues/2632/reactions\",\n                \"total_count\": 0,\n                \"+1\": 0,\n                \"-1\": 0,\n                \"laugh\": 0,\n                \"hooray\": 0,\n                \"confused\": 0,\n                \"heart\": 0,\n                \"rocket\": 0,\n                \"eyes\": 0\n              },\n              \"timeline_url\": \"https://api.github.com/repos/entireio/cli/issues/2632/timeline\",\n              \"performed_via_github_app\": null,\n              \"state_reason\": null,\n              \"score\": 1\n            },\n            {\n              \"url\": \"https://api.github.com/repos/entireio/cli/issues/2077\",\n              \"repository_url\": \"https://api.github.com/repos/entireio/cli\",\n              \"labels_url\": \"https://api.github.com/repos/entireio/cli/issues/2077/labels{/name}\",\n              \"comments_url\": \"https://api.github.com/repos/entireio/cli/issues/2077/comments\",\n              \"events_url\": \"https://api.github.com/repos/entireio/cli/issues/2077/events\",\n              \"html_url\": \"https://github.com/entireio/cli/pull/2077\",\n              \"id\": 5197891609,\n              \"node_id\": \"PR_kwDOQyo98M8AAAABAWJfZw\",\n              \"number\": 2077,\n              \"title\": \"feat(agent): add Goose and Qwen Code integrations\",\n              \"user\": {\n                \"login\": \"Ar9av\",\n                \"id\": 29639685,\n                \"node_id\": \"MDQ6VXNlcjI5NjM5Njg1\",\n                \"avatar_url\": \"https://avatars.githubusercontent.com/u/29639685?v=4\",\n                \"gravatar_id\": \"\",\n                \"url\": \"https://api.github.com/users/Ar9av\",\n                \"html_url\": \"https://github.com/Ar9av\",\n                \"followers_url\": \"https://api.github.com/users/Ar9av/followers\",\n                \"following_url\": \"https://api.github.com/users/Ar9av/following{/other_user}\",\n                \"gists_url\": \"https://api.github.com/users/Ar9av/gists{/gist_id}\",\n                \"starred_url\": \"https://api.github.com/users/Ar9av/starred{/owner}{/repo}\",\n                \"subscriptions_url\": \"https://api.github.com/users/Ar9av/subscriptions\",\n                \"organizations_url\": \"https://api.github.com/users/Ar9av/orgs\",\n                \"repos_url\": \"https://api.github.com/users/Ar9av/repos\",\n                \"events_url\": \"https://api.github.com/users/Ar9av/events{/privacy}\",\n                \"received_events_url\": \"https://api.github.com/users/Ar9av/received_events\",\n                \"type\": \"User\",\n                \"user_view_type\": \"public\",\n                \"site_admin\": false\n              },\n              \"labels\": [],\n              \"state\": \"open\",\n              \"locked\": false,\n              \"assignees\": [],\n              \"milestone\": null,\n              \"comments\": 0,\n              \"created_at\": \"2026-08-19T22:59:21Z\",\n              \"updated_at\": \"2026-08-28T13:29:36Z\",\n              \"closed_at\": null,\n              \"assignee\": null,\n              \"author_association\": \"NONE\",\n              \"issue_field_values\": [],\n              \"type\": null,\n              \"active_lock_reason\": null,\n              \"draft\": false,\n              \"pull_request\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/pulls/2077\",\n                \"html_url\": \"https://github.com/entireio/cli/pull/2077\",\n                \"diff_url\": \"https://github.com/entireio/cli/pull/2077.diff\",\n                \"patch_url\": \"https://github.com/entireio/cli/pull/2077.patch\",\n                \"merged_at\": null\n              },\n              \"body\": \"Closes #2160.\\n\\nAdds two agents: **Goose** (Agentic AI Foundation) and **Qwen Code** (Alibaba).\\n\\n```\\nentire enable --agent goose\\nentire enable --agent qwen-code\\n```\\n\\n![enable](https://raw.githubusercontent.com/Ar9av/cli/assets-goose/goose/01-enable.png)\\n\\n## Both agents' hooks are verified firing\\n\\nNeither agent completes a turn without a paid provider, so I ran each against a local OpenAI-compatible endpoint with Entire's hooks installed. These counts come from Entire's own logs after a real session:\\n\\n![hooks fire](https://raw.githubusercontent.com/Ar9av/cli/assets-goose/goose/07-hooks-fire.png)\\n\\nQwen fires `session-start` once, `turn-start` twice and `turn-end` once. The second `turn-start` comes from an internal subagent, which is worth knowing before someone reads it as a double-fire bug.\\n\\n## How these two were chosen\\n\\nI scored the Agentic Tools Almanac's 34 tools against what Entire needs: a turn-start hook, a turn-end hook, a native transcript on disk, and resume by session id. No tool in that catalogue documents all four, so I installed each finalist and probed it.\\n\\n**OpenHands was built and then dropped.** Its hooks load (`✓ Hooks loaded`) and `run_session_end()` is invoked, but the command never executes in headless mode. A plain `echo >> file` marker produced nothing across a full run. That matches what the Almanac found for Continue CLI. I could not verify the interactive path, so it is not here.\\n\\nOthers, each for a specific reason:\\n\\n| Tool | Vendor | Why not |\\n| --- | --- | --- |\\n| OpenHands | All Hands AI | Hooks never execute in headless mode. Verified locally |\\n| Cline | Cline Bot | `TaskComplete` is documented as \\\"coming soon\\\". The turn-end hook does not exist |\\n| Amp | Amp (ex-Sourcegraph) | No subprocess hooks. In-process TypeScript plugins only |\\n| Kiro | Amazon | No session-end event, no transcript, no resume |\\n| Amazon Q | AWS | AWS marks it unmaintained and points users at Kiro |\\n| Continue CLI | Continue Dev | Hooks never fire in headless mode. Repo read-only after the Cursor acquisition |\\n| Junie | JetBrains | Hook stdin carries no session id, so Entire cannot key session state without racing |\\n| Grok Build | xAI | Ships only a `curl \\\\| bash` installer, so I could not verify it |\\n\\nThe PyPI package named `devin-cli` self-describes as \\\"Unofficial CLI for Devin AI\\\", so it is not Cognition's.\\n\\n## Each agent stores its conversation differently\\n\\n| Agent | Storage | How Entire reads it |\\n| --- | --- | --- |\\n| Goose | SQLite (`sessions.db`) | `goose session export --format json` / `goose session import`, the OpenCode pattern |\\n| Qwen Code | JSONL per session | Directly. The hook hands over `transcript_path`, so no export step exists |\\n\\n![hooks config](https://raw.githubusercontent.com/Ar9av/cli/assets-goose/goose/04-hooks.png)\\n\\n## What the documentation got wrong\\n\\nEvery one of these came from running the agent, and every one would have been a silent bug:\\n\\n**1. Goose's file tools are `edit` and `write`, nothing else.** I first wrote the list from vendor docs and the Almanac. Capturing what Goose actually advertises shows five of my seven entries do not exist:\\n\\n```\\nclaimed:  text_editor, str_replace_editor, write_file, edit_file, edit, write, create\\nreal:     edit, write        (also shell, tree, read_image, load, analyze, delegate,\\n                              load_skill, apps__*, extensionmanager__*, todo__todo_write)\\n```\\n\\n`create` was not merely dead. It would have matched `apps__create_app`, which creates an *application*, so any session using that tool would have reported a bogus file in its checkpoint. There is also no `developer__text_editor`, despite both the vendor docs and the Almanac describing one.\\n\\n**2. `replace` is not a Qwen tool.** That is Gemini CLI's name for the edit tool; the fork renamed it `edit`. Qwen's real set is `write_file`, `edit`, `notebook_edit`, and I was missing the last one.\\n\\n**3. Goose's export names its array `conversation`, not `messages`.** OpenCode's analogous export uses `messages`. Copying that yields an empty transcript with no error.\\n\\n**4. Goose spells cache tokens differently in each layer:** `cache_read_input_tokens` in the export, `cache_read_tokens` in the SQLite column.\\n\\n**5. A Qwen `tool_result` line carries `message.role: \\\"user\\\"`.** Filtering prompts by role reports every tool result as a user prompt, so `ExtractPrompts` keys on `provenance: \\\"real_user\\\"`.\\n\\n## Verification\\n\\nBoth fixtures are genuine agent output, captured by driving each CLI against a local mock. Structure is real; the model's prose and chosen arguments are not, and both `AGENT.md` files say so.\\n\\n`gofmt`, `golangci-lint` 2.11.3, `go test -race ./cmd/...`, the integration suite, and the Vogon E2E canary all pass.\\n\\nBoth agents were also driven end to end through enable, hooks, commit and `checkpoint explain`. Goose's token totals match its export exactly (input 124.6k, cache read 112.8k, cache write 11.8k, output 394).\\n\\n![status](https://raw.githubusercontent.com/Ar9av/cli/assets-goose/goose/02-status.png)\\n\\n![qwen](https://raw.githubusercontent.com/Ar9av/cli/assets-goose/goose/05-qwen-status.png)\\n\\n![explain](https://raw.githubusercontent.com/Ar9av/cli/assets-goose/goose/03-explain.png)\\n\\n## Blast radius\\n\\nExisting agents are untouched. Outside the two new packages the diff adds 4 constants, 2 blank imports, 2 resume cases, 5 `AgentType` switch arms and 3 map entries. Nothing routes through a new agent unless someone runs `entire enable --agent <name>`.\\n\\nQwen is JSONL and line-addressed, so it joins the existing shared branches rather than needing its own. Goose counts messages instead of lines, so it gets explicit arms in the four `AgentType` switches that have no compile-time exhaustiveness check. The resume-command registry test caught a missing Qwen case during development, which is what those tests are for.\\n\\n## What is still not verified\\n\\nTwo things, both narrow, both stated in the `AGENT.md` files:\\n\\n1. **Goose's hook stdin field names.** Hooks are confirmed to fire, but the marker used did not capture stdin, so `session_id` and `working_dir` remain documentation-sourced. `session_id` is the only field this integration reads.\\n2. **Qwen's hook `timeout` unit.** Its docs express milliseconds and this writes `30000` on that basis. The unit was never observed, and either reading gives a workable budget.\\n\\nEvery claim in both `AGENT.md` files is tagged `[verified]` or `[documented]`.\\n\\n## Two things to push back on\\n\\n1. **Goose's `CalculateTokenUsage` ignores its `fromOffset`.** Goose reports session-level totals with no per-message usage to scope by, so it returns the total whatever offset it gets. Qwen does not have this problem. Documented on the method and pinned by a test, but it deviates from the interface contract.\\n2. **Both are `IsPreview() = true` with no `agent-help` classification change.** CLAUDE.md calls those product judgments, so I took the safe default and am flagging rather than deciding.\\n\\n## Screenshots branch\\n\\nThe images live on the `assets-goose` branch of my fork, kept out of this diff on purpose.\\n\\n\",\n              \"reactions\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/issues/2077/reactions\",\n                \"total_count\": 0,\n                \"+1\": 0,\n                \"-1\": 0,\n                \"laugh\": 0,\n                \"hooray\": 0,\n                \"confused\": 0,\n                \"heart\": 0,\n                \"rocket\": 0,\n                \"eyes\": 0\n              },\n              \"timeline_url\": \"https://api.github.com/repos/entireio/cli/issues/2077/timeline\",\n              \"performed_via_github_app\": null,\n              \"state_reason\": null,\n              \"score\": 1\n            },\n            {\n              \"url\": \"https://api.github.com/repos/entireio/cli/issues/3159\",\n              \"repository_url\": \"https://api.github.com/repos/entireio/cli\",\n              \"labels_url\": \"https://api.github.com/repos/entireio/cli/issues/3159/labels{/name}\",\n              \"comments_url\": \"https://api.github.com/repos/entireio/cli/issues/3159/comments\",\n              \"events_url\": \"https://api.github.com/repos/entireio/cli/issues/3159/events\",\n              \"html_url\": \"https://github.com/entireio/cli/pull/3159\",\n              \"id\": 6373978044,\n              \"node_id\": \"PR_kwDOQyo98M8AAAABO8YAmQ\",\n              \"number\": 3159,\n              \"title\": \"changelog-0-13-4\",\n              \"user\": {\n                \"login\": \"gtrrz-victor\",\n                \"id\": 881031,\n                \"node_id\": \"MDQ6VXNlcjg4MTAzMQ==\",\n                \"avatar_url\": \"https://avatars.githubusercontent.com/u/881031?v=4\",\n                \"gravatar_id\": \"\",\n                \"url\": \"https://api.github.com/users/gtrrz-victor\",\n                \"html_url\": \"https://github.com/gtrrz-victor\",\n                \"followers_url\": \"https://api.github.com/users/gtrrz-victor/followers\",\n                \"following_url\": \"https://api.github.com/users/gtrrz-victor/following{/other_user}\",\n                \"gists_url\": \"https://api.github.com/users/gtrrz-victor/gists{/gist_id}\",\n                \"starred_url\": \"https://api.github.com/users/gtrrz-victor/starred{/owner}{/repo}\",\n                \"subscriptions_url\": \"https://api.github.com/users/gtrrz-victor/subscriptions\",\n                \"organizations_url\": \"https://api.github.com/users/gtrrz-victor/orgs\",\n                \"repos_url\": \"https://api.github.com/users/gtrrz-victor/repos\",\n                \"events_url\": \"https://api.github.com/users/gtrrz-victor/events{/privacy}\",\n                \"received_events_url\": \"https://api.github.com/users/gtrrz-victor/received_events\",\n                \"type\": \"User\",\n                \"user_view_type\": \"public\",\n                \"site_admin\": false\n              },\n              \"labels\": [],\n              \"state\": \"closed\",\n              \"locked\": false,\n              \"assignees\": [],\n              \"milestone\": null,\n              \"comments\": 0,\n              \"created_at\": \"2026-11-13T15:03:08Z\",\n              \"updated_at\": \"2026-11-13T15:19:21Z\",\n              \"closed_at\": \"2026-11-13T15:19:18Z\",\n              \"assignee\": null,\n              \"author_association\": \"CONTRIBUTOR\",\n              \"issue_field_values\": [],\n              \"type\": null,\n              \"active_lock_reason\": null,\n              \"draft\": false,\n              \"pull_request\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/pulls/3159\",\n                \"html_url\": \"https://github.com/entireio/cli/pull/3159\",\n                \"diff_url\": \"https://github.com/entireio/cli/pull/3159.diff\",\n                \"patch_url\": \"https://github.com/entireio/cli/pull/3159.patch\",\n                \"merged_at\": \"2026-11-13T15:19:18Z\"\n              },\n              \"body\": \"This draft pull request was opened by [Entire](https://entire.com) to back a trail. Feel free to edit the title or body, but keep the hidden marker below: Entire uses it to close this pull request when the trail closes.\\n\\n<!-- entire-shadow-pr -->\\n\\n<!-- CURSOR_SUMMARY -->\\n---\\n\\n> [!NOTE]\\n> **Low Risk**\\n> Changelog-only update with no runtime or configuration behavior changes in this diff.\\n> \\n> **Overview**\\n> Adds a **[0.13.4] - 2026-11-13** section to the changelog documenting release highlights from prior merged work.\\n> \\n> **Added:** opt-in `redaction.drop_images` to strip checkpoint images (with agent coverage and upgrade caveats). **Changed:** `entire repo mirror add` now reports `still syncing` and exits 0 when `--timeout` hits during an in-progress initial clone (auth/token failures still fail). **Fixed:** pre-push panic regression with `extensions.worktreeConfig` / `config.worktree`, plus bare-repo open panic. Credits @MuskanPaliwal in **Thanks**.\\n> \\n> <sup>Reviewed by [Cursor Bugbot](https://cursor.com/bugbot) for commit 3a123c5a9b11bbcdf920b44c25513ca57440f42a. Configure [here](https://www.cursor.com/dashboard/bugbot).</sup>\\n<!-- /CURSOR_SUMMARY -->\",\n              \"reactions\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/issues/3159/reactions\",\n                \"total_count\": 0,\n                \"+1\": 0,\n                \"-1\": 0,\n                \"laugh\": 0,\n                \"hooray\": 0,\n                \"confused\": 0,\n                \"heart\": 0,\n                \"rocket\": 0,\n                \"eyes\": 0\n              },\n              \"timeline_url\": \"https://api.github.com/repos/entireio/cli/issues/3159/timeline\",\n              \"performed_via_github_app\": {\n                \"id\": 2626939,\n                \"client_id\": \"Iv23lieFG10uOnChW4TN\",\n                \"slug\": \"entire\",\n                \"node_id\": \"A_kwHOAfprLM4AKBV7\",\n                \"owner\": {\n                  \"login\": \"entireio\",\n                  \"id\": 33188652,\n                  \"node_id\": \"MDEyOk9yZ2FuaXphdGlvbjMzMTg4NjUy\",\n                  \"avatar_url\": \"https://avatars.githubusercontent.com/u/33188652?v=4\",\n                  \"gravatar_id\": \"\",\n                  \"url\": \"https://api.github.com/users/entireio\",\n                  \"html_url\": \"https://github.com/entireio\",\n                  \"followers_url\": \"https://api.github.com/users/entireio/followers\",\n                  \"following_url\": \"https://api.github.com/users/entireio/following{/other_user}\",\n                  \"gists_url\": \"https://api.github.com/users/entireio/gists{/gist_id}\",\n                  \"starred_url\": \"https://api.github.com/users/entireio/starred{/owner}{/repo}\",\n                  \"subscriptions_url\": \"https://api.github.com/users/entireio/subscriptions\",\n                  \"organizations_url\": \"https://api.github.com/users/entireio/orgs\",\n                  \"repos_url\": \"https://api.github.com/users/entireio/repos\",\n                  \"events_url\": \"https://api.github.com/users/entireio/events{/privacy}\",\n                  \"received_events_url\": \"https://api.github.com/users/entireio/received_events\",\n                  \"type\": \"Organization\",\n                  \"user_view_type\": \"public\",\n                  \"site_admin\": false\n                },\n                \"name\": \"Entire\",\n                \"description\": \"\",\n                \"external_url\": \"https://entire.com\",\n                \"html_url\": \"https://github.com/apps/entire\",\n                \"created_at\": \"2026-01-09T21:20:56Z\",\n                \"updated_at\": \"2026-10-23T08:32:31Z\",\n                \"permissions\": {\n                  \"administration\": \"read\",\n                  \"checks\": \"write\",\n                  \"contents\": \"write\",\n                  \"emails\": \"read\",\n                  \"members\": \"read\",\n                  \"metadata\": \"read\",\n                  \"pull_requests\": \"write\",\n                  \"statuses\": \"read\",\n                  \"workflows\": \"write\"\n                },\n                \"events\": [\n                  \"check_suite\",\n                  \"create\",\n                  \"delete\",\n                  \"fork\",\n                  \"member\",\n                  \"membership\",\n                  \"organization\",\n                  \"pull_request\",\n                  \"push\",\n                  \"repository\",\n                  \"star\",\n                  \"team\"\n                ]\n              },\n              \"state_reason\": null,\n              \"score\": 1\n            },\n            {\n              \"url\": \"https://api.github.com/repos/entireio/cli/issues/2124\",\n              \"repository_url\": \"https://api.github.com/repos/entireio/cli\",\n              \"labels_url\": \"https://api.github.com/repos/entireio/cli/issues/2124/labels{/name}\",\n              \"comments_url\": \"https://api.github.com/repos/entireio/cli/issues/2124/comments\",\n              \"events_url\": \"https://api.github.com/repos/entireio/cli/issues/2124/events\",\n              \"html_url\": \"https://github.com/entireio/cli/pull/2124\",\n              \"id\": 5247198554,\n              \"node_id\": \"PR_kwDOQyo98M8AAAABA86Otw\",\n              \"number\": 2124,\n              \"title\": \"Classify a cell's 401 as a credential rejection, not a raw error\",\n              \"user\": {\n                \"login\": \"Soph\",\n                \"id\": 70741,\n                \"node_id\": \"MDQ6VXNlcjcwNzQx\",\n                \"avatar_url\": \"https://avatars.githubusercontent.com/u/70741?v=4\",\n                \"gravatar_id\": \"\",\n                \"url\": \"https://api.github.com/users/Soph\",\n                \"html_url\": \"https://github.com/Soph\",\n                \"followers_url\": \"https://api.github.com/users/Soph/followers\",\n                \"following_url\": \"https://api.github.com/users/Soph/following{/other_user}\",\n                \"gists_url\": \"https://api.github.com/users/Soph/gists{/gist_id}\",\n                \"starred_url\": \"https://api.github.com/users/Soph/starred{/owner}{/repo}\",\n                \"subscriptions_url\": \"https://api.github.com/users/Soph/subscriptions\",\n                \"organizations_url\": \"https://api.github.com/users/Soph/orgs\",\n                \"repos_url\": \"https://api.github.com/users/Soph/repos\",\n                \"events_url\": \"https://api.github.com/users/Soph/events{/privacy}\",\n                \"received_events_url\": \"https://api.github.com/users/Soph/received_events\",\n                \"type\": \"User\",\n                \"user_view_type\": \"public\",\n                \"site_admin\": false\n              },\n              \"labels\": [],\n              \"state\": \"open\",\n              \"locked\": false,\n              \"assignees\": [],\n              \"milestone\": null,\n              \"comments\": 0,\n              \"created_at\": \"2026-08-25T14:45:11Z\",\n              \"updated_at\": \"2026-08-28T07:13:21Z\",\n              \"closed_at\": null,\n              \"assignee\": null,\n              \"author_association\": \"COLLABORATOR\",\n              \"issue_field_values\": [],\n              \"type\": null,\n              \"active_lock_reason\": null,\n              \"draft\": false,\n              \"pull_request\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/pulls/2124\",\n                \"html_url\": \"https://github.com/entireio/cli/pull/2124\",\n                \"diff_url\": \"https://github.com/entireio/cli/pull/2124.diff\",\n                \"patch_url\": \"https://github.com/entireio/cli/pull/2124.patch\",\n                \"merged_at\": null\n              },\n              \"body\": \"## Problem\\n\\nAn account whose `home_jurisdiction` is `eu` gets a 401 from every cell's semantic-search route, and we printed the service's body verbatim ([#2121](https://github.com/entireio/cli/issues/2121)):\\n\\n```\\nsearch failed: semantic search: search service error (401): Unauthorized\\n```\\n\\nThat names no region, offers no next step, and invites the one action that cannot possibly work — logging in again. The rejection is server-side and account-scoped ([entirehq/entire-search#196](https://github.com/entirehq/entire-search/issues/196)); the *same bearer* is accepted by code search at the same host.\\n\\nNow:\\n\\n```\\nsearch failed: semantic search: your credentials were rejected in aws-eu-central-1 — the search service refused a login that works everywhere else, so retrying and logging in again are both dead ends; 'entire doctor bundle' packages the details for a bug report\\n```\\n\\n**Setting expectations on how much this helps.** It doesn't make the search work — the index is server-side and the CLI has no local substitute — so all it can buy the user is the two things left: that retrying and re-authenticating are both dead ends (the #2121 reporter spent days on exactly that reflex), and the one action that changes anything. An earlier draft offered `entire search --code` as a consolation; that is now asserted against in the tests. Code search answers a different question, and pointing someone looking for session history at file matches reads as a fix while being none.\\n\\nThe thing that would actually help is a local fallback — [#1923](https://github.com/entireio/cli/issues/1923)'s second ask — and it is a feature, not a message. Worth knowing before anyone scopes it: local checkpoint trees reference blobs this clone does not have. `git grep` over `entire/checkpoints/v1` in this repo does find matches, but takes 30s+ and triggers `upload-pack: not our ref` fetches, so a local search would silently answer from partial data. \\\"No history\\\" from a partial index is the [#1923](https://github.com/entireio/cli/issues/1923) failure mode all over again, which is why this PR does not fake one.\\n\\n## What changed\\n\\n- **`search.ErrCellUnauthorized`** — `CellV4` classifies 401/403 the way it already classifies the two 404s, wrapping the status and the service's own message (`%w (HTTP 401): Unauthorized`) so debug logs keep the only clue to *which* auth stage refused. 403 joins 401: entire-search verifies a token and then declines it with 403 when the subject carries no account id.\\n- **A separate bucket in the fan-out.** Unauthorized cells stay in `failed` (coverage flags and accounting unchanged) but are tracked apart from cells that simply lack query-serve.\\n- **Priority when nothing answered:** credential rejection > transport/5xx > repo-filter miss > undeployed region. A rejection is the one outcome certain to repeat, and neither the repo nor the region message is true of it.\\n- **Partial-failure warning** naming the rejecting regions, because \\\"search failed in 1 of 2 regions\\\" reads as transient and this is not.\\n- **Keeps the `auth` telemetry class.** Rebased onto ENT-1938 (#2129 / #2143 line), where a cell 401 classified as `auth` via the typed `HTTPStatusError`. Left naively, this PR would have regressed that to `other`: the sentinel error carried no status and the fan-out replaced it with a plain `fmt.Errorf`. So `CellV4` now wraps *both* (`%w: %w` — sentinel for `errors.Is`, `HTTPStatusError` for `errors.As`, wording preserved by reusing `parseSearchResponse`), the fan-out returns main's `hintError` with every per-cell cause rather than the last, and `classifySearchError` gains an explicit `ErrCellUnauthorized` → `auth` case ahead of the status checks, per that file's stated convention.\\n\\nThis is the machine-readable distinction [#1923](https://github.com/entireio/cli/issues/1923) asks for, in the correct category. It is deliberately **not** reported as regional unavailability, which #2121 suggests as its fallback: that would mask a server bug as geography and promise an availability rollout that will never arrive. The existing `errNoRegionAvailable` still covers the real thing (a gateway 404 — query-serve genuinely not deployed).\\n\\n## Why the reporter's primary suggestion isn't here\\n\\n#2121 concludes the token's `aud=https://eu.entire.io` mismatches the `audience: https://entire.io` in `entire.io/.well-known/entire-api.json`, and asks us to mint the advertised audience. Probing prod says otherwise:\\n\\n| Bearer | semantic route | code route |\\n|---|---|---|\\n| login JWT (what cell clients actually send) | 200 both cells | 200 both cells |\\n| identity token `aud=https://eu.entire.io` | 200 both cells | 200 eu / **401 InvalidAudience** us |\\n| `aud=https://entire.io` (the advertised one) | **401** | **401 InvalidAudience** |\\n\\nMinting the advertised audience would break semantic search for everyone, and code search outright. `aud` is also never dialed, so `eu.entire.io` being NXDOMAIN is irrelevant — `au`/`in` are too, by design.\\n\\n## Drive-by: stale token comments\\n\\nChasing that audience theory cost real time because our own comments — and the CLAUDE.md \\\"Token rule\\\" — still describe cell clients as carrying minted per-jurisdiction identity tokens. `3df7ea461` (\\\"Use login JWTs directly for cell auth\\\") removed that exchange; `CellClientFactory.ClientFor` passes `subject.loginJWT` straight through, and `CellTarget`'s jurisdiction now selects only the *host*. Four sites corrected (`cell_fanout.go`, `search_v4.go`, `CellV4`'s doc, CLAUDE.md), noting that the minting path survives only behind `entire auth token --jurisdiction`.\\n\\nHappy to split this into its own PR if you'd rather keep the diff to the classification.\\n\\n## Testing\\n\\n- `mise run check` — fmt, lint (0 issues), unit + integration + canary all green.\\n- New: `TestCellV4_Unauthorized` (httptest, 401/403/raw-body, and that a 500 does *not* match); `TestMergeSemanticV4Responses_AllCellsUnauthorized`, `_UnauthorizedOutranksOtherExplanations`, `_PartialUnauthorized`.\\n- `TestCellV4_ErrorJSON` repointed at a 500, so the generic wording stays pinned for every unclassified status.\\n- Verified against prod: the probe table above, plus confirming `entire search` still works normally (my account is `us`-home).\\n- Rebase-specific: `TestClassifySemanticCells_UnauthorizedClassifiesAsAuth` pins the end-to-end contract (regions named, raw service error gone from the message, class still `auth`), as the sibling of main's `_SkipCausesClassify`. One semantic conflict the textual merge hid: main's `TestCellV4_ErrorJSON` asserted `StatusCode == 401` because that test used to serve a 401, and this PR repoints it to 500 — the assertion now checks 500, which is what makes it a real check rather than a coincidence.\\n\\n## Not in scope\\n\\nCode search's 401 path is untouched. It already returns a typed `*api.HTTPError`, and peregrine only 401s on a genuine audience mismatch — which would be *our* routing bug, a different class needing a different message.\\n\\nThree follow-ups I left alone: the older sentinels double the prefix (`semantic search: semantic search is not yet available …`) — my message omits it, but fixing theirs changes strings #1923 quotes; `entire doctor` still has no search-reachability check (#2121's third ask), which is where this error now points its users and so the natural next PR; and the local fallback discussed above.\\n\",\n              \"reactions\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/issues/2124/reactions\",\n                \"total_count\": 0,\n                \"+1\": 0,\n                \"-1\": 0,\n                \"laugh\": 0,\n                \"hooray\": 0,\n                \"confused\": 0,\n                \"heart\": 0,\n                \"rocket\": 0,\n                \"eyes\": 0\n              },\n              \"timeline_url\": \"https://api.github.com/repos/entireio/cli/issues/2124/timeline\",\n              \"performed_via_github_app\": null,\n              \"state_reason\": null,\n              \"score\": 1\n            },\n            {\n              \"url\": \"https://api.github.com/repos/entireio/cli/issues/2885\",\n              \"repository_url\": \"https://api.github.com/repos/entireio/cli\",\n              \"labels_url\": \"https://api.github.com/repos/entireio/cli/issues/2885/labels{/name}\",\n              \"comments_url\": \"https://api.github.com/repos/entireio/cli/issues/2885/comments\",\n              \"events_url\": \"https://api.github.com/repos/entireio/cli/issues/2885/events\",\n              \"html_url\": \"https://github.com/entireio/cli/pull/2885\",\n              \"id\": 6016791991,\n              \"node_id\": \"PR_kwDOQyo98M8AAAABKe7eCQ\",\n              \"number\": 2885,\n              \"title\": \"changelog 0.12.1\",\n              \"user\": {\n                \"login\": \"Soph\",\n                \"id\": 70741,\n                \"node_id\": \"MDQ6VXNlcjcwNzQx\",\n                \"avatar_url\": \"https://avatars.githubusercontent.com/u/70741?v=4\",\n                \"gravatar_id\": \"\",\n                \"url\": \"https://api.github.com/users/Soph\",\n                \"html_url\": \"https://github.com/Soph\",\n                \"followers_url\": \"https://api.github.com/users/Soph/followers\",\n                \"following_url\": \"https://api.github.com/users/Soph/following{/other_user}\",\n                \"gists_url\": \"https://api.github.com/users/Soph/gists{/gist_id}\",\n                \"starred_url\": \"https://api.github.com/users/Soph/starred{/owner}{/repo}\",\n                \"subscriptions_url\": \"https://api.github.com/users/Soph/subscriptions\",\n                \"organizations_url\": \"https://api.github.com/users/Soph/orgs\",\n                \"repos_url\": \"https://api.github.com/users/Soph/repos\",\n                \"events_url\": \"https://api.github.com/users/Soph/events{/privacy}\",\n                \"received_events_url\": \"https://api.github.com/users/Soph/received_events\",\n                \"type\": \"User\",\n                \"user_view_type\": \"public\",\n                \"site_admin\": false\n              },\n              \"labels\": [],\n              \"state\": \"closed\",\n              \"locked\": false,\n              \"assignees\": [],\n              \"milestone\": null,\n              \"comments\": 0,\n              \"created_at\": \"2026-10-24T19:34:45Z\",\n              \"updated_at\": \"2026-10-24T21:48:00Z\",\n              \"closed_at\": \"2026-10-24T21:47:58Z\",\n              \"assignee\": null,\n              \"author_association\": \"COLLABORATOR\",\n              \"issue_field_values\": [],\n              \"type\": null,\n              \"active_lock_reason\": null,\n              \"draft\": false,\n              \"pull_request\": {\n                \"url\": \"https://api.github.com/repos/entireio/cli/pulls/2885\",\n                \"html_url\": \"https://github.com/entireio/cli/pull/2885\",\n                \"diff_url\": \"https://github.com/entireio/cli/pull/2885.diff\",\n                \"patch_url\": \"https://github.com/entireio/cli/pull/2885.patch\",\n                \"merged_at\": \"2026-10-24T21:47:58Z\"\n              },\n              \"body\": \"<!-- entire-trail-link-start -->\\nhttps://entire.com/gh/entireio/-/trails/2507/changes/cli/1676\\n<!-- entire-trail-link-end -->\\n\\n<!-- CURSOR_SUMMARY -->\\n---\\n\\n> [!NOTE]\\n> **Low Risk**\\n> Documentation-only update to `CHANGELOG.md`; no runtime or build behavior changes in this diff.\\n> \\n> **Overview**\\n> Adds **0.12.1** (2026-10-24) release notes at the top of `CHANGELOG.md`, following Keep a Changelog.\\n> \\n> The new section catalogs shipped work from linked PRs: CLI additions (`checkpoint list --outgoing`, enable privacy notice, repo sync/resync, redaction IP category and stats, Droid token usage, brain plugin install prompt), trail link/show and enable/review behavior changes, and fixes for subagent token rollup, worktree