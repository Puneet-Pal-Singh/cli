nnectedDefault.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-brain/pull/452#pullrequestreview-5624332214\",\n        \"body\": \"\",\n        \"user\": {\n          \"login\": \"evisdren\",\n          \"name\": \"evisdren\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/u/256443556?u=db6e15770a2509911d4dfcbe8135d205d74825f1&v=4\",\n          \"id\": 256443556\n        },\n        \"id\": 5624332214,\n        \"pull_request_review_id\": null,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-10-23T05:35:29Z\",\n        \"updated_at\": null,\n        \"review\": \"COMMENTED\",\n        \"side\": null,\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": null,\n        \"body_html\": \"\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-brain/pull/452#discussion_r4356469494\",\n        \"body\": \"Fixed in 0e353c1f: a corrupt binding now fails the sync with a rebind remedy instead of warning. The stale-gitmeta fallback it could reach is gone entirely — COR-2236 removed the local-gitmeta backend, so no code path merges against the stale local head anymore.\",\n        \"user\": {\n          \"login\": \"evisdren\",\n          \"name\": \"evisdren\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/u/256443556?v=4\",\n          \"id\": 256443556\n        },\n        \"id\": 4356469494,\n        \"pull_request_review_id\": 5624332394,\n        \"in_reply_to_id\": 4356173687,\n        \"created_at\": \"2026-10-23T05:35:31Z\",\n        \"updated_at\": \"2026-10-23T05:35:31Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": \"internal/cli/facts_sync_cmd.go\",\n        \"body_html\": \"<p dir=\\\"auto\\\">Fixed in <a class=\\\"commit-link\\\" data-hovercard-type=\\\"commit\\\" data-hovercard-url=\\\"https://github.com/entireio/entire-brain/commit/0e353c1f410e0328e94d8181220ecac3486ae559/hovercard\\\" href=\\\"https://github.com/entireio/entire-brain/commit/0e353c1f410e0328e94d8181220ecac3486ae559\\\"><tt>0e353c1</tt></a>: a corrupt binding now fails the sync with a rebind remedy instead of warning. The stale-gitmeta fallback it could reach is gone entirely — COR-2236 removed the local-gitmeta backend, so no code path merges against the stale local head anymore.</p>\"\n      },\n      {\n        \"url\": \"https://github.com/entireio/entire-brain/pull/452#pullrequestreview-5624332394\",\n        \"body\": \"\",\n        \"user\": {\n          \"login\": \"evisdren\",\n          \"name\": \"evisdren\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/u/256443556?u=db6e15770a2509911d4dfcbe8135d205d74825f1&v=4\",\n          \"id\": 256443556\n        },\n        \"id\": 5624332394,\n        \"pull_request_review_id\": null,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-10-23T05:35:31Z\",\n        \"updated_at\": null,\n        \"review\": \"COMMENTED\",\n        \"side\": null,\n        \"line\": null,\n        \"start_line\": null,\n        \"path\": null,\n        \"body_html\": \"\"\n      }\n    ],\n    \"url\": \"https://github.com/entireio/entire-brain/pull/452\",\n    \"title\": \"entireio/entire-brain PR #452 comments\",\n    \"display_url\": \"https://github.com/entireio/entire-brain/pull/452\",\n    \"display_title\": \"entireio/entire-brain PR #452 comments\"\n  }\n}'"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"","exit_code":0,"duration":{"secs":0,"nanos":12000}},"started_at_ms":1794842133160,"completed_at_ms":1794842133160}}
