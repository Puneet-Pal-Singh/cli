\"https://github.com/entireio/cli\"\n      },\n      \"sha\": \"df765ab952185595d65f561f8ccb8036598980a8\",\n      \"user\": {\n        \"login\": \"entireio\",\n        \"id\": 33188652,\n        \"node_id\": \"REDACTED\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/33188652?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/entireio\",\n        \"html_url\": \"https://github.com/entireio\",\n        \"followers_url\": \"https://api.github.com/users/entireio/followers\",\n        \"following_url\": \"https://api.github.com/users/entireio/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/entireio/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/entireio/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/entireio/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/entireio/orgs\",\n        \"repos_url\": \"https://api.github.com/users/entireio/repos\",\n        \"events_url\": \"https://api.github.com/users/entireio/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/entireio/received_events\",\n        \"type\": \"Organization\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      }\n    },\n    \"_links\": {\n      \"comments\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/issues/1647/comments\"\n      },\n      \"commits\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/1647/commits\"\n      },\n      \"statuses\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/statuses/818eb75910beada4d35c7ff6f237f05eac373c74\"\n      },\n      \"html\": {\n        \"href\": \"https://github.com/entireio/cli/pull/1647\"\n      },\n      \"issue\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/issues/1647\"\n      },\n      \"review_comments\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/1647/comments\"\n      },\n      \"review_comment\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/comments{/number}\"\n      },\n      \"self\": {\n        \"href\": \"https://api.github.com/repos/entireio/cli/pulls/1647\"\n      }\n    },\n    \"author_association\": \"CONTRIBUTOR\",\n    \"auto_merge\": null,\n    \"draft\": false,\n    \"merged\": false,\n    \"mergeable\": false,\n    \"rebaseable\": false,\n    \"mergeable_state\": \"dirty\",\n    \"merged_by\": null,\n    \"comments\": 2,\n    \"review_comments\": 8,\n    \"maintainer_can_modify\": false,\n    \"commits\": 27,\n    \"additions\": 2770,\n    \"deletions\": 93,\n    \"changed_files\": 36\n  },\n  \"c\": {\n    \"comments\": [\n      {\n        \"url\": \"https://github.com/entireio/cli/pull/1647#discussion_r3528497122\",\n        \"body\": \"### Commit cap drops newest commits\\n\\n**High Severity**\\n\\n<!-- DESCRIPTION START -->\\nWhen the commit list exceeds `scopeMaxCommits`, `capScopeLines` keeps the first lines of `git log --reverse` output, so the oldest commits stay in `ScopeContext` and everything nearer `HEAD` is dropped. The prompt still treats that list as authoritative and tells reviewers not to re-derive scope, so long branches can miss recent changes entirely.\\n<!-- DESCRIPTION END -->\\n\\n<!-- BUGBOT_BUG_ID: d59de872-702f-4ed0-81f3-4c4c2e2f8d55 -->\\n\\n<!-- LOCATIONS START\\ncmd/entire/cli/review/scope.go#L287-L332\\nLOCATIONS END -->\\n<div><a href=\\\"https://cursor.com/open?REDACTED\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-cursor-light.png\\\"><img alt=\\\"Fix in Cursor\\\" width=\\\"115\\\" height=\\\"28\\\" src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"></picture></a>&nbsp;<a href=\\\"https://cursor.com/agents?REDACTED\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://cursor.com/assets/images/fix-in-web-light.png\\\"><img alt=\\\"Fix in Web\\\" width=\\\"99\\\" height=\\\"28\\\" src=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"></picture></a></div>\\n\\n\\n<sup>Reviewed by [Cursor Bugbot](https://cursor.com/bugbot) for commit ac36d1773c3d0c7e7623550add333fbd3b56512b. Configure [here](https://www.cursor.com/dashboard/bugbot).</sup>\\n\",\n        \"user\": {\n          \"login\": \"cursor[bot]\",\n          \"name\": \"cursor[bot]\",\n          \"email\": null,\n          \"avatar_url\": \"https://avatars.githubusercontent.com/in/1210556?v=4\",\n          \"id\": 206951365\n        },\n        \"id\": 3528497122,\n        \"pull_request_review_id\": 4635418375,\n        \"in_reply_to_id\": null,\n        \"created_at\": \"2026-07-06T11:33:45Z\",\n        \"updated_at\": \"2026-07-06T11:33:45Z\",\n        \"review\": null,\n        \"side\": \"RIGHT\",\n        \"line\": 395,\n        \"start_line\": null,\n        \"path\": \"cmd/entire/cli/review/scope.go\",\n        \"body_html\": \"<h3 dir=\\\"auto\\\">Commit cap drops newest commits</h3>\\n<p dir=\\\"auto\\\"><strong>High Severity</strong></p>\\n\\n<p dir=\\\"auto\\\">When the commit list exceeds <code class=\\\"notranslate\\\">scopeMaxCommits</code>, <code class=\\\"notranslate\\\">capScopeLines</code> keeps the first lines of <code class=\\\"notranslate\\\">git log --reverse</code> output, so the oldest commits stay in <code class=\\\"notranslate\\\">ScopeContext</code> and everything nearer <code class=\\\"notranslate\\\">HEAD</code> is dropped. The prompt still treats that list as authoritative and tells reviewers not to re-derive scope, so long branches can miss recent changes entirely.</p>\\n\\n\\n\\n<div dir=\\\"auto\\\"><a href=\\\"https://cursor.com/open?REDACTED\\\" rel=\\\"nofollow\\\"><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/a3745bd9c9e494e3d083228c1efdaf4ec2d519ad1c6adb4160d1c56c1ddeeb7b/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://camo.githubusercontent.com/8f892a2b1c7e36d49621daf12d83d3200c0ad6842ca1f6d8422631d06c99b3b2/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6c696768742e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-light.png\\\"><img alt=\\\"Fix in Cursor\\\" width=\\\"115\\\" height=\\\"28\\\" src=\\\"https://camo.githubusercontent.com/a3745bd9c9e494e3d083228c1efdaf4ec2d519ad1c6adb4160d1c56c1ddeeb7b/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d637572736f722d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-cursor-dark.png\\\"></picture></themed-picture></a> <a href=\\\"https://cursor.com/agents?REDACTED\\\" rel=\\\"nofollow\\\"><themed-picture data-catalyst-inline=\\\"true\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://camo.githubusercontent.com/d32f310773b0b80ca3035d8154dc711fc85b63281369057b12943376f7715734/68747470733a2f2f637572736f722e636f6d2f6173736574732f696d616765732f6669782d696e2d7765622d6461726b2e706e67\\\" data-canonical-src=\\\"https://cursor.com/assets/images/fix-in-web-dark.png\\\"><source media=\\\"(prefers-color-scheme: light)\\\" srcset=\\\"https://camo.githubusercontent.com/17d98663d2364520c70e7bc21f8c60be71acb1cdae85dd48