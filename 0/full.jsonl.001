allSettled(jobs))console.log(x.status==='fulfilled'?x.value:x.reason.message);\\nJS\",\"yield_time_ms\":1000,\"max_output_tokens\":5300}","call_id":"call_x9ZIPUrBUbyCCiaibZvqy7yq","internal_chat_message_metadata_passthrough":{"turn_id":"01a1eac6-41d3-7143-a221-cf44a37b6525","create_time":1794940511.867261}},"metadata":{"history_sequence":637,"sampled_through_sequence":634,"client_authored":false,"user_input_order":98}}
