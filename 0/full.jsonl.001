n        \"received_events_url\": \"https://api.github.com/users/jaysomani/received_events\",\n        \"type\": \"User\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      }\n    },\n    \"base\": {\n      \"label\": \"entireio:main\",\n      \"ref\": \"main\",\n      \"repo\": {\n        \"id\": 1205118051,\n        \"node_id\": \"R_kgDOR9SkYw\",\n        \"name\": \"git-sync\",\n        \"full_name\": \"entireio/git-sync\",\n        \"owner\": {\n          \"login\": \"entireio\",\n          \"id\": 33188652,\n          \"node_id\": \"REDACTED\",\n          \"avatar_url\": \"https://avatars.githubusercontent.com/u/33188652?v=4\",\n          \"gravatar_id\": \"\",\n          \"url\": \"https://api.github.com/users/entireio\",\n          \"html_url\": \"https://github.com/entireio\",\n          \"followers_url\": \"https://api.github.com/users/entireio/followers\",\n          \"following_url\": \"https://api.github.com/users/entireio/following{/other_user}\",\n          \"gists_url\": \"https://api.github.com/users/entireio/gists{/gist_id}\",\n          \"starred_url\": \"https://api.github.com/users/entireio/starred{/owner}{/repo}\",\n          \"subscriptions_url\": \"https://api.github.com/users/entireio/subscriptions\",\n          \"organizations_url\": \"https://api.github.com/users/entireio/orgs\",\n          \"repos_url\": \"https://api.github.com/users/entireio/repos\",\n          \"events_url\": \"https://api.github.com/users/entireio/events{/privacy}\",\n          \"received_events_url\": \"https://api.github.com/users/entireio/received_events\",\n          \"type\": \"Organization\",\n          \"user_view_type\": \"public\",\n          \"site_admin\": false\n        },\n        \"private\": false,\n        \"fork\": false,\n        \"archived\": false,\n        \"disabled\": false,\n        \"description\": \"🪩 Mirror git refs from a source remote to a target remote without a local checkout. Packfiles stream directly over Smart HTTP and an in-memory object store.\",\n        \"homepage\": \"\",\n        \"language\": \"Go\",\n        \"visibility\": \"public\",\n        \"is_template\": false,\n        \"topics\": [],\n        \"forks_count\": 32,\n        \"forks\": 32,\n        \"stargazers_count\": 522,\n        \"watchers_count\": 522,\n        \"watchers\": 522,\n        \"open_issues_count\": 11,\n        \"open_issues\": 11,\n        \"size\": 96110,\n        \"default_branch\": \"main\",\n        \"has_issues\": true,\n        \"has_projects\": false,\n        \"has_wiki\": false,\n        \"has_pages\": false,\n        \"has_downloads\": false,\n        \"has_discussions\": false,\n        \"has_pull_requests\": true,\n        \"pushed_at\": \"2026-11-12T19:19:28Z\",\n        \"created_at\": \"2026-04-08T16:47:15Z\",\n        \"updated_at\": \"2026-11-11T14:54:03Z\",\n        \"allow_forking\": true,\n        \"web_commit_signoff_required\": false,\n        \"pull_request_creation_policy\": \"all\",\n        \"license\": {\n          \"key\": \"mit\",\n          \"name\": \"MIT License\",\n          \"url\": \"https://api.github.com/licenses/mit\",\n          \"spdx_id\": \"MIT\",\n          \"node_id\": \"MDc6TGljZW5zZTEz\"\n        },\n        \"url\": \"https://api.github.com/repos/entireio/git-sync\",\n        \"html_url\": \"https://github.com/entireio/git-sync\",\n        \"archive_url\": \"https://api.github.com/repos/entireio/git-sync/{archive_format}{/ref}\",\n        \"assignees_url\": \"https://api.github.com/repos/entireio/git-sync/assignees{/user}\",\n        \"blobs_url\": \"https://api.github.com/repos/entireio/git-sync/git/blobs{/sha}\",\n        \"branches_url\": \"https://api.github.com/repos/entireio/git-sync/branches{/branch}\",\n        \"collaborators_url\": \"https://api.github.com/repos/entireio/git-sync/collaborators{/collaborator}\",\n        \"comments_url\": \"https://api.github.com/repos/entireio/git-sync/comments{/number}\",\n        \"commits_url