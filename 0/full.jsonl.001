tion\\.go|persistent\\.go/.test(x)),hits:relevant.slice(0,9),errors:result.filter(x=>x.status==='rejected').map(x=>x.reason.message.slice(0,220))};}));for(const item of results)console.log(repo,item.status==='fulfilled'?JSON.stringify(item.value):item.reason.message);\n}\nJS"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"cli {\"id\":2996,\"pr\":[\"open\",false,\"fix(review): persist findings when session matching fails\"],\"counts\":[3,0,1,6],\"relatedPaths\":[\"cmd/entire/cli/review/manifest.go\"],\"hits\":[],\"errors\":[]}\ncli {\"id\":1768,\"pr\":[\"closed\",true,\"feat(checkpoint): add checkpoint list --json (machine-readable listing; migrate off rewind --list)\"],\"counts\":[0,2,2,12],\"relatedPaths\":[\"cmd/entire/cli/checkpoint_group.go\"],\"hits\":[\"**Known minor follow-up:** the condensed `--json` truncation note suggests re-running with `--limit`, which `checkpoint list` does not yet expose (stderr-only, fires only past the default cap).\"],\"errors\":[]}\ncli {\"id\":2605,\"pr\":[\"open\",false,\"List remote-only imported checkpoints in fresh git-refs clones\"],\"counts\":[1,2,4,2],\"relatedPaths\":[],\"hits\":[\"- Imported prompts are read only for entries that survive `--limit`.\\r\"],\"errors\":[]}\ncli {\"id\":1589,\"pr\":[\"closed\",true,\"feat(transcript): externalize images (Claude Code, Codex) + capture Cursor sidecar images\"],\"counts\":[1,4,4,23],\"relatedPaths\":[\"cmd/entire/cli/checkpoint/persistent.go\"],\"hits\":[\"- **Claude Code & Codex — transcript codec (lossless round trip).** Inline base64 images are lifted out of the transcript and replaced with a compact, path-bearing placeholder (`entire-asset:assets/img-<id>.<ext>`); on restore the exact bytes are re-injected in place. Contract: `ReinjectImages(Extra\",\"- **Real data:** Claude — a real 17MB session log round-trips byte-exact; Codex — 176 images across 12 real rollouts, valid magic on every asset, up to ~119 MB saved; Cursor — a real 48KB JPEG from an actual `store.db` extracted and verified.\",\"- **Timeout** — the `sqlite3` shell-out now runs under a 30s deadline so a locked/malformed `store.db` can't hang the commit/stop hook.\",\"cmd/entire/cli/transcript/imageextract/imageextract.go `newAssetID` ignores the `crypto/rand` read error. If `rand.Read` ever fails, this can silently generate an all-zero ID, causing asset filename collisions and incorrect placeholder→asset mapping (broken reinjection).\",\"cmd/entire/cli/transcript/imageextract/imageextract.go Fixed in f647e25. newAssetID now returns an error on rand.Read failure, propagated through uniqueImageName and ExtractImages; on failure the transcript is left inline rather than externalized with an all-zero id. A uniqueImageName guard also gua\",\"cmd/entire/cli/transcript/imageextract/imageextract.go The global value swap is intentional and does not break the round trip: it is a value-preserving, reversible substitution, so ReinjectImages restores every occurrence (image or text) to the identical bytes. A data-field-scoped swap was tried but\",\"- Wires extraction into manual-commit condensation **before** redaction and persists extracted assets into checkpoint trees; restores by reinjecting assets on read when placeholders exist.\",\"| cmd/entire/cli/strategy/manual_commit_condensation.go | Runs image externalization pre-redaction and plumbs extracted assets into checkpoint write options. |\\r\"],\"errors\":[]}\ncli {\"id\":1144,\"pr\":[\"closed\",true,\"feat: machine-readable export surface for sessions and checkpoints\"],\"counts\":[3,7,5,7],\"relatedPaths\":[\"cmd/entire/cli/explain_export.go\",\"cmd/entire/cli/explain_export_test.go\"],\"hits\":[\"> `entire checkpoint explain` gains `--json` (metadata-only list or single-checkpoint envelope with `partial` + per-session `error` reporting), `--transcript` (stream v2 compact transcript), `--session-index` (select session in multi-session checkpoints), and `--limit` (cap JSON list output with tru\"],\"errors\":[]}\ncli {\"id\":2069,\"pr\":[\"open\",false,\"fix(checkpoint): externalize images in subagent transcripts before size cap\"],\"counts\":[1,4,3,12],\"relatedPaths\":[\"cmd/entire/cli/checkpoint/persistent.go\"],\"hits\":[\"**Why / how it helps:** Subagent path only sanitized then size-checked/redacted, so image-heavy transcripts were dropped whole and Codex `input_image` base64 reached redaction intact (corruption risk).\",\"**How:** `prepareSubagentTranscript`: sanitize → optional `imageextract` → size-check externalized bytes; wire assets into persistent + ephemeral task writers.\",\"This PR updates the subagent-transcript storage pipeline in the checkpoint subsystem so that (when enabled) inline base64 images are externalized into checkpoint assets **before** enforcing the 50MB blob cap, aligning subagent handling with the main session transcript path and preventing image-heavy\",\"- Extend `prepareSubagentTranscript` to: sanitize → (opt-in) image externalize → size-check, returning extracted assets alongside the rewritten transcript.\",\"- Wire extracted task assets into both persistent (`treeWriter`) and ephemeral (shadow-branch) task checkpoint writers under `tasks/<id>/assets/`.\",\"| cmd/entire/cli/checkpoint/subagent_transcript.go | Adds image externalization to the subagent transcript preparation pipeline and returns extracted assets. |\",\"| cmd/entire/cli/checkpoint/persistent.go | Persists extracted task assets into the committed checkpoint tree under the task subtree. |\",\"| cmd/entire/cli/checkpoint/ephemeral.go | Persists extracted task assets into the shadow-branch task subtree via tree-surgery changes. |\"],\"errors\":[]}\ncli {\"id\":3151,\"pr\":[\"open\",false,\"muskan/externalize-images-codex-generates\"],\"counts\":[0,0,1,9],\"relatedPaths\":[],\"hits\":[],\"errors\":[]}\ncli {\"id\":3057,\"pr\":[\"open\",false,\"fix(checkpoint): remove the partial pack a failed checkpoint fetch leaves\"],\"counts\":[3,2,4,3],\"relatedPaths\":[],\"hits\":[],\"errors\":[]}\ncli {\"id\":1166,\"pr\":[\"closed\",true,\"feat(review): warn user when review manifest is not persisted\"],\"counts\":[0,1,2,3],\"relatedPaths\":[],\"hits\":[\"**`cmd/entire/cli/lifecycle.go`** — Two-line debug log added to the `EnvSession`-not-set silent return. The other four branches in `adoptReviewEnv` already log at WARN (agent mismatch, SHA mismatch, malformed skills JSON) or DEBUG (success). This was the only branch with no breadcrumb, so a \\\"review \",\"> Prevents silent failures in `entire review` when local manifest persistence is skipped: `writePostReviewManifest` now prints a **user-visible note** (via new `warnManifestNotWritten`) when session state can’t be loaded, no matching review sessions are found, or manifest disk writes fail.\"],\"errors\":[]}\nentire-brain {\"id\":403,\"pr\":[\"closed\",true,\"Per-fact push + reachability-filtered pull (COR-2126)\"],\"counts\":[0,6,4,11],\"relatedPaths\":[\"internal/cli/hosted_feed_cache.go\",\"internal/cli/hosted_feed_cache_test.go\"],\"hits\":[\"- Feed-cache loader skips corrupt lines but a single >4 MiB line would wedge it (`bufio.Scanner` cap); no realistic fact approaches that size.\",\"When `state.json` loads but `records.ndjson` is absent, `loadHostedFeedCache` returns the stored cursor with an empty item map. Pull then resumes from that cursor and never refetches earlier pages. Facts not already in the branch store are skipped permanently until a server 400 forces a cursor reset\",\"internal/cli/hosted_feed_cache.go Fixed in ae76950a: a state.json without its records.ndjson now loads as an empty cache, cursor included, so the next pull refetches from the start instead of resuming past unseen pages. Pinned by TestHostedFeedCacheMissingRecordsResetsCursor.\"],\"errors\":[]}\nentire-brain {\"id\":452,\"pr\":[\"closed\",true,\"One memory-sync path: per-fact wire everywhere (COR-2233: COR-2234 + COR-2235 + COR-2236)\"],\"counts\":[0,4,3,64],\"relatedPaths\":[],\"hits\":[\"Both findings on d2a89cd are fixed in 0e353c1: the NO_EGRESS skip answers in JSON under `--json`, and a corrupt hosted binding fails the sync with a rebind remedy instead of warning and merging against the stale local head.\",\"internal/cli/facts_sync_cmd.go ### Corrupt binding syncs stale git-meta\",\"internal/cli/facts_sync_cmd.go Fixed in 0e353c1f: a corrupt binding now fails the sync with a rebind remedy instead of warning. The stale-gitmeta fallback it could reach is gone entirely — COR-2236 removed the local-gitmeta backend, so no code path merges against the stale local head anymore.\"],\"errors\":[]}\nentire-brain {\"id\":604,\"pr\":[\"closed\",true,\"Give foreground Brain writes priority over background work\"],\"counts\":[0,1,1,40],\"relatedPaths\":[\"internal/cli/facts_manifest.go\"],\"hits\":[],\"errors\":[]}\ngit-sync {\"id\":18,\"pr\":[\"closed\",true,\"Expand on integration tests\"],\"counts\":[0,2,3,6],\"relatedPaths\":[\"internal/validation/validation.go\"],\"hits\":[\"internal/validation/validation.go ### Same-repo check bypassed by trailing slash difference\",\"`ValidateEndpoints` compares URLs with plain string equality after trimming whitespace, but doesn't normalize trailing slashes. URLs like `https://example.com/r.git` and `https://example.com/r.git/` point to the same repository on virtually all Git hosting platforms, yet bypass this safety check. Th\"],\"errors\":[]}\ngit-sync {\"id\":108,\"pr\":[\"closed\",true,\"Bind explicit credentials to the host they were configured for\"],\"counts\":[1,6,6,7],\"relatedPaths\":[],\"hits\":[],\"errors\":[]}\ngit-sync {\"id\":122,\"pr\":[\"open\",false,\"fix: refuse POST redirects in guardRedirects unless FollowInfoRefsRedirect is set\"],\"counts\":[5,6,4,3],\"relatedPaths\":[],\"hits\":[],\"errors\":[]}\ngit-sync {\"id\":124,\"pr\":[\"closed\",true,\"fix: authenticate the GitHub repo-size preflight and log its outcome\"],\"counts\":[8,11,19,13],\"relatedPaths\":[],\"hits\":[],\"errors\":[]}\n","exit_code":0,"duration":{"secs":9,"nanos":7242625}},"started_at_ms":1794940476389,"completed_at_ms":1794940485398}}
{"timestamp":"2026-11-17T18:34:50.176Z","ordinal":3314,"type":"response_item","payload":{"type":"function_call","status":"completed","id":"fc_05a7fc4dc4b68e03016afc9e4780b087d0b86151fc1bb81e50","name":"exec_command","arguments":"{\"cmd\":\"sed -n '60,175p' cmd/entire/cli/checkpoint_group.go; sed -n '806,885p' cmd/entire/cli/explain_export.go; rg -n 'Test.*(CheckpointList|ExplainList)|list capped at' cmd/entire/cli -g'*_test.go' | head -45; gh api repos/entireio/cli/issues/2089 --jq '.body'; git ls-remote --heads https://github.com/entireio/git-sync.git | wc -l\",\"yield_time_ms\":1000,\"max_output_tokens\":5500}","call_id":"call_3bFuyLZvIybUULqnzjMp88Yl","internal_chat_message_metadata_passthrough":{"turn_id":"01a1eac6-41d3-7143-a221-cf44a37b6525","create_time":1794940486.32684}},"metadata":{"history_sequence":627,"sampled_through_sequence":626,"client_authored":false,"user_input_order":94}}
{"timestamp":"2026-11-17T18:34:50.457Z","ordinal":3315,"type":"token_usage_record","payload":{"thread_id":"01a1d516-ad7f-7071-81ac-409a5dad90b1","turn_id":"01a1eac6-41d3-7143-a221-cf44a37b6525","session_id":"01a1d516-ad7f-7071-81ac-409a5dad90b1","root_turn_id":"01a1eac6-41d3-7143-a221-cf44a37b6525","response_id":"resp_05a7fc4dc4b68e03016afc9e4437bc87d091db78545f2452c7","usage":{"input_tokens":144106,"cached_input_tokens":143104,"cache_write_input_tokens":0,"output_tokens":145,"reasoning_output_tokens":0,"total_tokens":144251},"turn_token_usage":{"input_tokens":1978974,"cached_input_tokens":1440128,"cache_write_input_tokens":0,"output_tokens":9757,"reasoning_output_tokens":389,"total_tokens":1988731},"thread_token_usage":{"input_tokens":61254686,"cached_input_tokens":58449280,"cache_write_input_tokens":0,"output_tokens":241253,"reasoning_output_tokens":96519,"total_tokens":61495939}}}
{"timestamp":"2026-11-17T18:34:51.476Z","ordinal":3316,"type":"response_item","payload":{"type":"function_call_output","id":"fco_01a1eaca-56cf-7011-ab6b-1ade9ab33f61","call_id":"call_3bFuyLZvIybUULqnzjMp88Yl","output":"Chunk ID: baa769\nWall time: 1.0046 seconds\nProcess running with session ID 63413\nOriginal token count: 2774\nOutput:\nWarning: truncated output (original token count: 2774)\nTotal output lines: 216\n\n// newCheckpointListCmd wraps the existing branch-default list view and adds\n// machine-readable (--json), pending-checkpoint (--pending) and outgoing\n// (--outgoing) modes.\n//\n// Dataset/format matrix:\n//\n//\t(default)            condensed checkpoints on the branch, human view (pager)\n//\t--json               condensed checkpoints as JSON (branchCheckpointJSON shape)\n//\t--pending            next-checkpoint preview + task records + logs-only\n//\t                     points, human list\n//\t--pending --json     the same as a JSON array, in the shape the removed\n//\t                     `rewind --list` produced\n//\t--outgoing           checkpoints the next push sends to the checkpoint\n//\t                     sync destination (git-refs backend only), read\n//\t                     locally, human list\n//\t--outgoing --json    the same as one JSON object (outgoingCheckpointsJSON)\n//\n// The condensed dataset (entire/checkpoints/v1 for the branch) and the pending\n// dataset (strategy.PreviewNextCheckpoint plus strategy.ListPendingCheckpoints;\n// task records, logs-only points, condensation IDs) are deliberately distinct —\n// see issue #1767.\nfunc newCheckpointListCmd() *cobra.Command {\n\tvar sessionFlag string\n\tvar noPagerFlag bool\n\tvar jsonFlag bool\n\tvar pendingFlag bool\n\tvar outgoingFlag bool\n\n\tcmd := &cobra.Command{\n\t\tUse:   cmdList,\n\t\tShort: \"List checkpoints on the current branch\",\n\t\tLong: `List checkpoints on the current branch.\n\nBy default shows condensed checkpoints from the checkpoints branch for the\ncurrent branch. Use --pending for work that is not a checkpoint yet:\n\n  - A preview of the next checkpoint for each session in this worktree with\n    pending work. Agent turns are recorded in session state, not in git, so\n    this work has no checkpoint ID until you commit it. The preview shows the\n    turns since the last checkpoint, the files touched, subagent task records,\n    and the prompts since the last checkpoint.\n  - Subagent task records of other sessions on HEAD (not yet condensed).\n  - Logs-only resume points recovered from commits whose logs are already\n    condensed.\n\nUse --outgoing to see what your next 'git push' sends: the checkpoints\nqueued for the checkpoint sync remote, read from local state with no network\ncall. Each one shows its ID, age, agent, first prompt (or summary) and the\nfiles it touched. It needs the git-refs checkpoint backend, which pushes one\nref per checkpoint; the git-branch backend pushes entire/checkpoints/v1 as one\nbranch, so --outgoing reports an error there.\n\nOutput modes:\n  --json              Machine-readable JSON instead of the human view.\n  --pending           Select the pending dataset described above.\n  --pending --json    The pending dataset as a JSON array.\n  --outgoing          Select the outgoing dataset described above.\n  --outgoing --json   The outgoing dataset as one JSON object.\n\nEach --pending --json element has id, message, metadata_dir, date (RFC3339),\nis_task_checkpoint, is_logs_only, and when set tool_use_id, condensation_id,\nsession_id and session_prompt. A next-checkpoint preview element has an empty\nid, \"is_next_checkpoint\": true, and a \"next_checkpoint\" object:\n\n  {\"agent\": \"...\", \"turns\": 2,\n   \"files_touched\": [\"...\"],\n   \"task_records\": [{\"tool_use_id\": \"...\", \"subagent_type\": \"...\",\n                     \"description\": \"...\", \"status\": \"running|completed\"}],\n   \"prompts\": [\"...\"]}\n\nThe arrays are always present, possibly empty.\n\nThe --outgoing --json object has checkpoint_push_disabled,\ncheckpoint_sync_remote, checkpoint_sync_remote_source and\ncheckpoint_sync_error (as in 'entire status --json'), stale_queue_entries\nand a checkpoints array of {checkpoint_id, ref, created_at, agent,\nsession_count, prompt, summary, files_touched, error}. The array is always\npresent, possibly empty.\n\nOptionally filter condensed checkpoints by session ID with --session\n(not applicable with --pending or --outgoing).`,\n\t\tRunE: func(cmd *cobra.Command, _ []string) error {\n\t\t\tif checkDisabledGuard(cmd.Context(), cmd.OutOrStdout()) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tctx := cmd.Context()\n\t\t\tw := cmd.OutOrStdout()\n\t\t\terrW := cmd.ErrOrStderr()\n\n\t\t\t// --session filters the condensed dataset only; the pending dataset\n\t\t\t// mirrors the historical rewind --list, which had no session filter.\n\t\t\tif pendingFlag && sessionFlag != \"\" {\n\t\t\t\treturn errors.New(\"--session cannot be combined with --pending\")\n\t\t\t}\n\t\t\tif outgoingFlag && pendingFlag {\n\t\t\t\treturn errors.New(\"--outgoing cannot be combined with --pending\")\n\t\t\t}\n\t\t\tif outgoingFlag && sessionFlag != \"\" {\n\t\t\t\treturn errors.New(\"--session cannot be combined with --outgoing\")\n\t\t\t}\n\n\t\t\tswitch {\n\t\t\tcase outgoingFlag && jsonFlag:\n\t\t\t\treturn runCheckpointOutgoingListJSON(ctx, w, errW)\n\t\t\tcase outgoingFlag:\n\t\t\t\treturn runCheckpointOutgoingListHuman(ctx, w, errW, noPagerFlag)\n\t\t\tcase pendingFlag && jsonFlag:\n\t\t\t\treturn runCheckpointPendingListJSON(ctx, w)\n\t\t\tcase pendingFlag:\n\t\t\t\treturn runCheckpointPendingListHuman(ctx, w)\n\t\t\tcase jsonFlag:\n\t\t\t\treturn r…1094 chars truncated… err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn NewSilentError(ctx.Err())\n\t\t}\n\t\t// JSON consumers cannot distinguish \"[]\" from \"fetch failed\" if we\n\t\t// swallow the error. Surface it so scripts get a non-zero exit and\n\t\t// a real diagnostic instead of silently degraded output.\n\t\treturn fmt.Errorf(\"failed to list checkpoints: %w\", err)\n\t}\n\t// getBranchCheckpoints budgets the live and imported lists independently,\n\t// so it can return up to 2*limit entries. Hard-cap the combined array to\n\t// the requested limit for the JSON contract.\n\tif len(points) > limit {\n\t\tpoints = points[:limit]\n\t\ttruncated = true\n\t}\n\n\tout := make([]branchCheckpointJSON, 0, len(points))\n\tfor _, p := range points {\n\t\tif sessionFilter != \"\" && !checkpointMatchesSessionFilter(p, sessionFilter) {\n\t\t\tcontinue\n\t\t}\n\t\tentry := branchCheckpointJSON{\n\t\t\tSessionID:        p.SessionID,\n\t\t\tAgent:            string(p.Agent),\n\t\t\tDate:             p.Date,\n\t\t\tMessage:          p.Message,\n\t\t\tIsTaskCheckpoint: p.IsTaskCheckpoint,\n\t\t\tIsLogsOnly:       p.IsLogsOnly,\n\t\t\tSessionCount:     p.SessionCount,\n\t\t\tSessionIDs:       p.SessionIDs,\n\t\t}\n\t\tif !p.CheckpointID.IsEmpty() {\n\t\t\tentry.CheckpointID = p.CheckpointID.String()\n\t\t} else {\n\t\t\tentry.CheckpointID = p.ID\n\t\t}\n\t\tout = append(out, entry)\n\t}\n\n\tenc := json.NewEncoder(w)\n\tenc.SetIndent(\"\", \"  \")\n\tif err := enc.Encode(out); err != nil {\n\t\treturn fmt.Errorf(\"failed to encode checkpoint list: %w\", err)\n\t}\n\n\tif truncated {\n\t\tfmt.Fprintf(errW, \"note: list capped at %d checkpoints; rerun with --limit <N> to see more\\n\", limit)\n\t}\n\treturn nil\n}\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:131:func TestCheckpointListOutgoing_EmptyBeforeAnyCheckpoint(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:143:// TestCheckpointListOutgoing_MatchesWhatPushSends is the command's contract:\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:146:func TestCheckpointListOutgoing_MatchesWhatPushSends(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:175:// TestCheckpointListOutgoing_RewriteAfterPushGoesOutAgain commits in the\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:178:func TestCheckpointListOutgoing_RewriteAfterPushGoesOutAgain(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:210:func TestCheckpointListOutgoing_PushDisabled(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:234:// TestCheckpointListOutgoing_FollowsElectedRemote elects \"publish\" over origin:\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:237:func TestCheckpointListOutgoing_FollowsElectedRemote(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:298:func TestCheckpointListOutgoing_NoNetwork(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:315:func TestCheckpointListOutgoing_DedicatedCheckpointRemote(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:342:// TestCheckpointListOutgoing_GitRefsQueueEntries: a queued ref deleted locally\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:345:func TestCheckpointListOutgoing_GitRefsQueueEntries(t *testing.T) {\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:384:// TestCheckpointListOutgoing_RefusesGitBranch: a git-branch push sends\ncmd/entire/cli/integration_test/checkpoint_list_outgoing_test.go:387:func TestCheckpointListOutgoing_RefusesGitBranch(t *testing.T) {\ncmd/entire/cli/integration_test/setup_cmd_test.go:101:func TestCheckpointListPendingBlockedWhenDisabled(t *testing.T) {\ncmd/entire/cli/checkpoint_list_test.go:128:// TestCheckpointListCmd_Routing drives the real `checkpoint list` command\ncmd/entire/cli/checkpoint_list_test.go:134:func TestCheckpointListCmd_Routing(t *testing.T) {\ncmd/entire/cli/checkpoint_list_test.go:199:// TestCheckpointListPending_PreviewText pins the human view of the\ncmd/entire/cli/checkpoint_list_test.go:202:func TestCheckpointListPending_PreviewText(t *testing.T) {\ncmd/entire/cli/checkpoint_list_test.go:217:// TestCheckpointListPending_PreviewJSON pins the preview row of the JSON\ncmd/entire/cli/checkpoint_list_test.go:221:func TestCheckpointListPending_PreviewJSON(t *testing.T) {\ncmd/entire/cli/checkpoint_list_test.go:257:// TestCheckpointListPending_PreviewEmptyArraysPresent pins that the preview's\ncmd/entire/cli/checkpoint_list_test.go:260:func TestCheckpointListPending_PreviewEmptyArraysPresent(t *testing.T) {\ncmd/entire/cli/checkpoint_list_test.go:279:// TestCheckpointListCmd_SessionWithPendingErrors verifies --session is rejected\ncmd/entire/cli/checkpoint_list_test.go:281:func TestCheckpointListCmd_SessionWithPendingErrors(t *testing.T) {\ncmd/entire/cli/checkpoint_list_test.go:293:// TestCheckpointListCmd_OutgoingRejectsOtherDatasets: --outgoing is its own\ncmd/entire/cli/checkpoint_list_test.go:296:func TestCheckpointListCmd_OutgoingRejectsOtherDatasets(t *testing.T) {\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1eac6-41d3-7143-a221-cf44a37b6525","create_time":1794940491.471641}},"metadata":{"history_sequence":628,"sampled_through_sequence":626,"client_authored":false,"fallback_token_limit_override":3000}}
