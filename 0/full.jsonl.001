pi.github.com/repos/entireio/cli/statuses/{sha}\",\n        \"subscribers_url\": \"https://api.github.com/repos/entireio/cli/subscribers\",\n        \"subscription_url\": \"https://api.github.com/repos/entireio/cli/subscription\",\n        \"tags_url\": \"https://api.github.com/repos/entireio/cli/tags\",\n        \"teams_url\": \"https://api.github.com/repos/entireio/cli/teams\",\n        \"trees_url\": \"https://api.github.com/repos/entireio/cli/git/trees{/sha}\",\n        \"clone_url\": \"https://github.com/entireio/cli.git\",\n        \"mirror_url\": null,\n        \"hooks_url\": \"https://api.github.com/repos/entireio/cli/hooks\",\n        \"svn_url\": \"https://github.com/entireio/cli\"\n      },\n      \"sha\": \"eff67a73047caa949022fcda3c6537ebf8ce572f\",\n      \"user\": {\n        \"login\": \"entireio\",\n        \"id\": 33188652,\n        \"node_id\": \"REDACTED\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/33188652?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/entireio\",\n        \"html_url\": \"https://github.com/entireio\",\n        \"followers_url\": \"https://api.github.com/users/entireio/followers\",\n        \"following_url\": \"https://api.github.com/users/entireio/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/entireio/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/entireio/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/entireio/subscriptions\",\n        \"organizations_url\": \"https:/'"],"cwd":"file:///Users/puneetpalsingh/Documents/Code/OSSplayground/Entire/cli","parsed_cmd":[{"type":"unknown","cmd":"python3 -c 'import sys;open(sys.argv[1],\"ab\").write(sys.argv[2].encode())' '/Users/puneetpalsingh/.codex/entire-20-audit-2026-11-16/public/cli-1146.json' '{\n  \"p\": {\n    \"url\": \"https://api.github.com/repos/entireio/cli/pulls/1146\",\n    \"id\": 3646222152,\n    \"node_id\": \"PR_kwDOQyo98M7ZVO9I\",\n    \"html_url\": \"https://github.com/entireio/cli/pull/1146\",\n    \"diff_url\": \"https://github.com/entireio/cli/pull/1146.diff\",\n    \"patch_url\": \"https://github.com/entireio/cli/pull/1146.patch\",\n    \"issue_url\": \"https://api.github.com/repos/entireio/cli/issues/1146\",\n    \"commits_url\": \"https://api.github.com/repos/entireio/cli/pulls/1146/commits\",\n    \"review_comments_url\": \"https://api.github.com/repos/entireio/cli/pulls/1146/comments\",\n    \"review_comment_url\": \"https://api.github.com/repos/entireio/cli/pulls/comments{/number}\",\n    \"comments_url\": \"https://api.github.com/repos/entireio/cli/issues/1146/comments\",\n    \"statuses_url\": \"https://api.github.com/repos/entireio/cli/statuses/eff67a73047caa949022fcda3c6537ebf8ce572f\",\n    \"number\": 1146,\n    \"state\": \"closed\",\n    \"locked\": false,\n    \"title\": \"Add experimental `entire learn` command with embedded markdown + release-time regen\",\n    \"user\": {\n      \"login\": \"alishakawaguchi\",\n      \"id\": 6415609,\n      \"node_id\": \"MDQ6VXNlcjY0MTU2MDk=\",\n      \"avatar_url\": \"https://avatars.githubusercontent.com/u/6415609?v=4\",\n      \"gravatar_id\": \"\",\n      \"url\": \"https://api.github.com/users/alishakawaguchi\",\n      \"html_url\": \"https://github.com/alishakawaguchi\",\n      \"followers_url\": \"https://api.github.com/users/alishakawaguchi/followers\",\n      \"following_url\": \"https://api.github.com/users/alishakawaguchi/following{/other_user}\",\n      \"gists_url\": \"https://api.github.com/users/alishakawaguchi/gists{/gist_id}\",\n      \"starred_url\": \"https://api.github.com/users/alishakawaguchi/starred{/owner}{/repo}\",\n      \"subscriptions_url\": \"https://api.github.com/users/alishakawaguchi/subscriptions\",\n      \"organizations_url\": \"https://api.github.com/users/alishakawaguchi/orgs\",\n      \"repos_url\": \"https://api.github.com/users/alishakawaguchi/repos\",\n      \"events_url\": \"https://api.github.com/users/alishakawaguchi/events{/privacy}\",\n      \"received_events_url\": \"https://api.github.com/users/alishakawaguchi/received_events\",\n      \"type\": \"User\",\n      \"user_view_type\": \"public\",\n      \"site_admin\": false\n    },\n    \"body\": \"<!-- entire-trail-link-start -->\\r\\nhttps://entire.io/gh/entireio/cli/trails/323\\r\\n<!-- entire-trail-link-end -->\\r\\n\\r\\nMade `entire learn` so I can stop teaching agents how to use the CLI. Tired of pasting instructions in every prompt and watching them `-h` their way through every subcommand, or having to update my agent.md file all the time. Now I can just point at `entire learn`.\\r\\n\\r\\n## Summary\\r\\n\\r\\nAdds `entire learn`, an experimental Hidden top-level command (advertised under `entire labs`) that renders a state-aware tour of the CLI. Two rendering modes:\\r\\n\\r\\n1. **Default `entire learn`** — reads pre-rendered markdown from `cmd/entire/cli/learn/embedded/learn.md`, passes it through glamour, prints. ~50ms file-read + render.\\r\\n2. **`entire learn --regenerate`** (hidden, maintainer-only) — runs a TextGenerator agent against the live cobra tree to refresh `embedded/learn.md` before each release. Output is raw markdown to stdout; the command refuses to run unless stdout is redirected.\\r\\n\\r\\nRelease CI integration in `.github/workflows/release.yml` runs `mise run learn:regenerate` (atomic write + validation: ≥4 `## ` headers, presence of the `docs.entire.io/cli` footer) before GoReleaser. The regen step is `continue-on-error: true` so a flaky agent or missing `ANTHROPIC_API_KEY` doesn'\"'\"'t block the release; a dedicated Slack notification fires on regen failure separately from the existing release-failure alert.\\r\\n\\r\\nState-aware rendering: when Entire isn'\"'\"'t enabled in the current repo, prints a short setup prompt; when enabled but no agent hooks are installed, prints an agent-install prompt; once a first commit has been captured, falls through to the full embedded tour (with a one-paragraph tail explaining that search/resume/rewind will gain real data after the next commit).\\r\\n\\r\\nMirrors `entire review`'\"'\"'s shape: top-level `Hidden: true`, advertised in `experimentalCommands` for `entire labs`.\\r\\n\\r\\n**Demos**\\r\\nhttps://cleanshot.com/share/35CFYwL1\\r\\n\\r\\n## Test plan\\r\\n\\r\\n- [x] `mise run learn:regenerate` locally with `ANTHROPIC_API_KEY` set produces a valid `embedded/learn.md` (≥4 `## ` headers, includes `docs.entire.io/cli` footer)\\r\\n- [x] `entire learn` from a fresh checkout shows the embedded tour, rendered through glamour\\r\\n- [x] `entire learn --regenerate > /tmp/learn.md` produces sanitized markdown (control sequences stripped); refuses to run if stdout is a TTY\\r\\n- [x] `entire learn --help` shows correct help text\\r\\n- [x] `entire labs` lists `entire learn`\\r\\n- [x] State-aware fallbacks: setup prompt when disabled, agent-install prompt when enabled-without-agent, first-capture tail before any commit\\r\\n- [x] Existing tests: `go test ./cmd/entire/cli/learn/...` passes (tests parallelized and hardened against host environment)\\r\\n- [x] Release workflow triggered on a `-rc.test` tag exercises the regen path end-to-end\\r\\n\\r\\n## Notes\\r\\n\\r\\nThe branch went through several code review passes (Claude-driven parallel agent reviews + codex adversarial review). Major findings addressed:\\r\\n- NBSP-mid-tagname Unicode bypass in tag escape\\r\\n- Terminal-injection sanitization on agent output before persistence\\r\\n- Atomic-write mise task with stronger CI validation\\r\\n- External-agent discovery in `ResolveTextGenerator` (mirrors `resolveCheckpointSummaryProvider`)\\r\\n- Settings double-load avoided via cached closure\\r\\n- Per-command descriptions required in capability sections of the regenerated markdown\\r\\n- `t.Parallel()` added to all learn-package tests; tests hardened against host environment (no reliance on real \\\\$HOME, real git config, or ambient `ENTIRE_*` env)\\r\\n\\r\\nThe earlier `--latest` blog-digest mode (RSS fetch + summarize most recent `entire.io` post) was removed during the rename back to `learn`: it added a network-dependent path that didn'\"'\"'t fit the \\\\\\\"teach the CLI surface\\\\\\\" framing. The embedded-markdown + maintainer-regenerate flow is the whole feature now.\\r\\n\\r\\nDeferred to follow-up PRs: spinner/TUI dedup with `dispatch_tui.go`, `checkpoint.HasCommitted` short-circuit, dispatch'\"'\"'s `sanitizeDispatchPromptString` consolidation with the new `stripInvisibles`.\\r\\n\\r\\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\\r\\n\\r\\n<!-- CURSOR_SUMMARY -->\\r\\n---\\r\\n\\r\\n> [!NOTE]\\r\\n> **Medium Risk**\\r\\n> Adds a new top-level CLI command plus agent-driven generation paths and modifies the release workflow; failures are best-effort but could affect shipped tour content and release-time automation.\\r\\n>\\r\\n> **Overview**\\r\\n> Adds an experimental hidden `entire learn` command (advertised via `entire labs`) that renders a state-aware CLI tour from an embedded `learn.md` by default, with `--regenerate` (hidden) producing the embedded markdown via an agent.\\r\\n>\\r\\n> Introduces a new `cmd/entire/cli/learn` package to discover the cobra command surface, resolve repo stage (setup/agent install/first capture/workflow), build hardened agent prompts (tag-escape + control-sequence stripping), and select an available TextGenerator (including external `entire-agent-*`). Adds a small TUI spinner while agent work runs and extends `mdrender` to allow per-command style overrides.\\r\\n>\\r\\n> Updates the release GitHub Action to *best-effort* regenerate the embedded tour (installs pinned Claude CLI, runs `mise run learn:regenerate` with validation/atomic write), annotate failures, and send a dedicated Slack warning when regeneration fails without failing the release.\\r\\n>\\r\\n> <sup>Originally reviewed by [Cursor Bugbot](https://cursor.com/bugbot) for an earlier commit when the command was named `tour`. Configure [here](https://www.cursor.com/dashboard/bugbot).</sup>\\r\\n<!-- /CURSOR_SUMMARY -->\",\n    \"labels\": [],\n    \"milestone\": null,\n    \"active_lock_reason\": null,\n    \"created_at\": \"2026-05-07T22:50:26Z\",\n    \"updated_at\": \"2026-06-11T05:02:44Z\",\n    \"closed_at\": \"2026-05-15T16:23:59Z\",\n    \"merged_at\": null,\n    \"merge_commit_sha\": \"65ab7eef60e8dfa84a84944d5d12baec1239c23a\",\n    \"assignee\": {\n      \"login\": \"alishakawaguchi\",\n      \"id\": 6415609,\n      \"node_id\": \"MDQ6VXNlcjY0MTU2MDk=\",\n      \"avatar_url\": \"https://avatars.githubusercontent.com/u/6415609?v=4\",\n      \"gravatar_id\": \"\",\n      \"url\": \"https://api.github.com/users/alishakawaguchi\",\n      \"html_url\": \"https://github.com/alishakawaguchi\",\n      \"followers_url\": \"https://api.github.com/users/alishakawaguchi/followers\",\n      \"following_url\": \"https://api.github.com/users/alishakawaguchi/following{/other_user}\",\n      \"gists_url\": \"https://api.github.com/users/alishakawaguchi/gists{/gist_id}\",\n      \"starred_url\": \"https://api.github.com/users/alishakawaguchi/starred{/owner}{/repo}\",\n      \"subscriptions_url\": \"https://api.github.com/users/alishakawaguchi/subscriptions\",\n      \"organizations_url\": \"https://api.github.com/users/alishakawaguchi/orgs\",\n      \"repos_url\": \"https://api.github.com/users/alishakawaguchi/repos\",\n      \"events_url\": \"https://api.github.com/users/alishakawaguchi/events{/privacy}\",\n      \"received_events_url\": \"https://api.github.com/users/alishakawaguchi/received_events\",\n      \"type\": \"User\",\n      \"user_view_type\": \"public\",\n      \"site_admin\": false\n    },\n    \"assignees\": [\n      {\n        \"login\": \"alishakawaguchi\",\n        \"id\": 6415609,\n        \"node_id\": \"MDQ6VXNlcjY0MTU2MDk=\",\n        \"avatar_url\": \"https://avatars.githubusercontent